--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/k-means_centroid_init.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"// This node finds a pallete of k-values derived from the image
// The furthest color from any other existing centroid is picked as the next newest centroid, which means areas without decent centroid coverage are more likely to get a new centroid - furthest point sampling
// We only loop over a grid of pixels from the third input (image source) as it gives us decent enough starting centroids and cuts down on computation times

#bind layer &centroid_palette float3
#bind layer &grid_values float
#bind layer input_img float4 


@KERNEL
{
    // Only work item 0 computes the palette and writes every entry; the rest exit
    if(@ix != 0)
    {
        return;
    }
   
    float3 black = {0.0f, 0.0f, 0.0f};
    float3 mean_color = black;
    
    int grid_safe = @grid_values.xres;
    int grid_n = grid_safe * grid_safe;
    
    int x_step = @input_img.xres / grid_safe;
    int y_step = @input_img.yres / grid_safe;
    
    int k_num = @xres;

    // Initialize first centroid location to the average color. Scan over a grid of pixels instead of entire image for faster compute times
    for(int pt_x = 0; pt_x < grid_safe; pt_x++)
    {
        for(int pt_y = 0; pt_y < grid_safe; pt_y++)
        {
            mean_color += @input_img.bufferIndex((int2)(x_step * pt_x, y_step * pt_y)).xyz;
            @grid_values.setIndex((int2)(pt_x, pt_y), 1e30f);
        }     
    }
    
    mean_color /= grid_n;
    @centroid_palette.setIndex((int2)(0, 0), mean_color);
   
    // Initialize the remaining centroids to the furthest color from any of the initialized centroids for a more even centroid spread
    float3 newest_centroid = mean_color;
    for(int k = 1; k < k_num; k++)
    {
        float farthest_dist = -1;
        float3 farthest_color = mean_color;
        
        for(int pt_x = 0; pt_x < grid_safe; pt_x++)
        {
            for(int pt_y = 0; pt_y < grid_safe; pt_y++)
            {
                // Color grabbed from the input image grid
                float3 color = @input_img.bufferIndex((int2)(x_step * pt_x, y_step * pt_y)).xyz;
                
                // The pixel's assigned centroid is the one it's closest to
                float nearest_dist = @grid_values.bufferIndex((int2)(pt_x, pt_y));
                float dist = fast_distance(color, newest_centroid);

                // Here we find and store the dist to the nearest centroid, so when a new centroid is added, we only need to check if the dist to the new centroid is smaller than the previous nearest dist
                if(dist < nearest_dist)
                {
                    nearest_dist = dist;
                    @grid_values.setIndex((int2)(pt_x, pt_y), nearest_dist);        
                }
                
                // If this distance is bigger than any other pixel-to-assigned-centroid distance, it is the greatest current \"outlier\" and is a candidate for the newest centroid
                if(nearest_dist > farthest_dist)
                {
                    farthest_dist = nearest_dist;
                    farthest_color = color;
                }    
            }  
        }
        @centroid_palette.setIndex((int2)(k, 0), farthest_color);
        newest_centroid = farthest_color;
    }
}
"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	0	0	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
options_iterations	[ 0	locks=0 ]	(	1	)
options_iteration	[ 0	locks=0 ]	(	"off"	)
usewritebackkernel	[ 0	locks=0 ]	(	"off"	)
options_time	[ 0	locks=0 ]	(	"off"	)
options_timeinccontext	[ 0	locks=0 ]	(	"on"	)
options_timeinc	[ 0	locks=0 ]	(	"off"	)
options_timescale	[ 0	locks=0 ]	(	1	)
options_timemethod	[ 0	locks=0 ]	(	"invert"	)
options_importprequel	[ 0	locks=0 ]	(	"on"	)
options_timing	[ 0	locks=0 ]	(	"off"	)
cablerenamebylabel	[ 0	locks=0 ]	(	"off"	)
filter	[ 0	locks=0 ]	(	"box"	)
options_precision	[ 0	locks=0 ]	(	"32"	)
inputs	[ 0	locks=0 ]	(	3	)
parm_spacerparm	[ 0	locks=0 ]	(	)
outputs	[ 0	locks=0 ]	(	2	)
bindings	[ 0	locks=0 ]	(	0	)
displaycode	[ 0	locks=0 ]	(	0	)
generatedcode	[ 0	locks=0 ]	(	""	)
input1_name	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	centroid_palette	)
input1_type	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"float3"	)
input1_optional	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"off"	)
input2_name	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	grid_values	)
input2_type	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"float"	)
input2_optional	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"off"	)
input3_name	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	input_img	)
input3_type	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"float4"	)
input3_optional	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"off"	)
output1_name	[ 0	locks=0 ]	(	centroid_palette	)
output1_type	[ 0	locks=0 ]	(	"float3"	)
output1_metadata	[ 0	locks=0 ]	(	"first"	)
output1_precision	[ 0	locks=0 ]	(	"node"	)
output1_typeinfo	[ 0	locks=0 ]	(	"node"	)
output1_attribtypeinfo	[ 0	locks=0 ]	(	"node"	)
output1_metaname	[ 0	locks=0 ]	(	""	)
output2_name	[ 0	locks=0 ]	(	grid_values	)
output2_type	[ 0	locks=0 ]	(	"float"	)
output2_metadata	[ 0	locks=0 ]	(	"match"	)
output2_precision	[ 0	locks=0 ]	(	"node"	)
output2_typeinfo	[ 0	locks=0 ]	(	"node"	)
output2_attribtypeinfo	[ 0	locks=0 ]	(	"node"	)
output2_metaname	[ 0	locks=0 ]	(	""	)
stdswitcher6	[ 0	locks=0 ]	(	0	0	0	0	0	)
folder_generatedparms_kernelcode	[ 0	locks=0 ]	(	0	)
}

