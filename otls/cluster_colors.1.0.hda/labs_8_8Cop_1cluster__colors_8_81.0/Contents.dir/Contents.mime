--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/assign_clusters_to_pixels.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"// This node loops through all the pixels and finds the closest centroid value, then changes the pixel color to the centroid color
// This results in the image being limited to only the centroid colors, giving a posterizing effect

#bind layer input_img float4 
#bind layer centroid_palette float3
#bind layer !&clustered_img float4
#bind layer !&index int

@KERNEL
{
    // Get the number of ks from number of pixels on input centroid palette
    int k_num = @centroid_palette.xres;
    
    float3 first_k = @centroid_palette.bufferIndex((int2)(0, 0)).xyz;
    float nearest_dist = fast_distance(@input_img.xyz, first_k);
    
    int k_index = 0;
    
    // Find the closest centroid color to the pixel color
    for(int k = 1; k < k_num; k++)
    {
        float3 k_color = @centroid_palette.bufferIndex((int2)(k, 0)).xyz;
        float dist = fast_distance(@input_img.xyz, k_color);
       
        if(dist < nearest_dist)
        {
            nearest_dist = dist;
            k_index = k;
        }
    }
    
    // Replace pixel color with located centroid color
    float4 result = (float4)(@centroid_palette.bufferIndex((int2)(k_index, 0)).xyz, @input_img.w);
    @clustered_img.set(result);
    @index.set(k_index);
}
"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	1	1	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
options_iterations	[ 0	locks=0 ]	(	1	)
options_iteration	[ 0	locks=0 ]	(	"off"	)
usewritebackkernel	[ 0	locks=0 ]	(	"off"	)
options_time	[ 0	locks=0 ]	(	"off"	)
options_timeinccontext	[ 0	locks=0 ]	(	"on"	)
options_timeinc	[ 0	locks=0 ]	(	"off"	)
options_timescale	[ 0	locks=0 ]	(	1	)
options_timemethod	[ 0	locks=0 ]	(	"invert"	)
options_importprequel	[ 0	locks=0 ]	(	"on"	)
options_timing	[ 0	locks=0 ]	(	"off"	)
cablerenamebylabel	[ 0	locks=0 ]	(	"off"	)
filter	[ 0	locks=0 ]	(	"box"	)
options_precision	[ 0	locks=0 ]	(	"32"	)
inputs	[ 0	locks=0 ]	(	2	)
parm_spacerparm	[ 0	locks=0 ]	(	)
outputs	[ 0	locks=0 ]	(	2	)
bindings	[ 0	locks=0 ]	(	0	)
displaycode	[ 0	locks=0 ]	(	0	)
generatedcode	[ 0	locks=0 ]	(	""	)
input1_name	[ 0	locks=0 ]	(	input_img	)
input1_type	[ 0	locks=0 ]	(	"float4"	)
input1_optional	[ 0	locks=0 ]	(	"off"	)
input2_name	[ 0	locks=0 ]	(	centroid_palette	)
input2_type	[ 0	locks=0 ]	(	"float3"	)
input2_optional	[ 0	locks=0 ]	(	"off"	)
output1_name	[ 0	locks=0 ]	(	clustered_img	)
output1_type	[ 0	locks=0 ]	(	"float4"	)
output1_metadata	[ 0	locks=0 ]	(	"first"	)
output1_precision	[ 0	locks=0 ]	(	"node"	)
output1_typeinfo	[ 0	locks=0 ]	(	"node"	)
output1_attribtypeinfo	[ 0	locks=0 ]	(	"node"	)
output1_metaname	[ 0	locks=0 ]	(	""	)
output2_name	[ 0	locks=0 ]	(	index	)
output2_type	[ 0	locks=0 ]	(	"int"	)
output2_metadata	[ 0	locks=0 ]	(	"first"	)
output2_precision	[ 0	locks=0 ]	(	"node"	)
output2_typeinfo	[ 0	locks=0 ]	(	"node"	)
output2_attribtypeinfo	[ 0	locks=0 ]	(	"node"	)
output2_metaname	[ 0	locks=0 ]	(	""	)
}

