--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/sum_column_values.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"// This node processes all columns at the same time. It loops over all y-values in a column
// It takes the pixel's color from input_img and the corresponding centroid index from pixel_index
// And += the color value to column_sum, used as an array, at [column_n, pixel_index], with the w-value being the overall count

#bind layer &column_sum float4
#bind layer input_img float4
#bind layer pixel_index int

@KERNEL
{
    for(int y = 0; y < @input_img.yres; y++)
    {
        float3 color = @input_img.bufferIndex((int2)(@ix, y)).xyz;
        int pixel_index = @pixel_index.bufferIndex((int2)(@ix, y));
        
        float4 current_total = @column_sum.bufferIndex((int2)(@ix, pixel_index));
        @column_sum.setIndex((int2)(@ix, pixel_index), current_total + (float4)(color, 1.0f));
    }    
}
"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	1	0	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
options_iterations	[ 0	locks=0 ]	(	1	)
options_iteration	[ 0	locks=0 ]	(	"off"	)
usewritebackkernel	[ 0	locks=0 ]	(	"off"	)
options_time	[ 0	locks=0 ]	(	"off"	)
options_timeinccontext	[ 0	locks=0 ]	(	"on"	)
options_timeinc	[ 0	locks=0 ]	(	"off"	)
options_timescale	[ 0	locks=0 ]	(	1	)
options_timemethod	[ 0	locks=0 ]	(	"invert"	)
options_importprequel	[ 0	locks=0 ]	(	"on"	)
options_timing	[ 0	locks=0 ]	(	"off"	)
cablerenamebylabel	[ 0	locks=0 ]	(	"off"	)
filter	[ 0	locks=0 ]	(	"box"	)
options_precision	[ 0	locks=0 ]	(	"32"	)
