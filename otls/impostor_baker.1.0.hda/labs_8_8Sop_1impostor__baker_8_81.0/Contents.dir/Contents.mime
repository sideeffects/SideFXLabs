--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/calculate_camera_pos_guide.chn"
Content-Type: text/plain

{
    channel grid_size {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../framesxy\") }
    }
    channel radius {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = "detail(-1, \"bound\", 0)" }
    }
    channel mode {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../impostortype\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/calculate_camera_pos_guide.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"// === CONFIG ===
int N = chi(\"grid_size\");
int mode = chi(\"mode\");
float distance = getbbox_size(1).y;

// === ITERATOR ===
int i = @ptnum;
int col = i % N;
int row = i / N;

float u = float(col) / float(N - 1);
float v = float(row) / float(N - 1);

float cx = u * 2.0 - 1.0;
float cy = v * 2.0 - 1.0;

// === DIRECTION ===
vector dir;

if (mode == 0) {
    // Full Sphere - Octahedron
    float z = 1.0 - abs(cx) - abs(cy);
    float x, y;
    if (z < 0) {
        x = sign(cx) * (1.0 - abs(cy));
        y = sign(cy) * (1.0 - abs(cx));
    } else {
        x = cx;
        y = cy;
    }
    dir = normalize(set(x, y, z));
    dir = set(dir.x, dir.z, dir.y);

} else if (mode == 1) {
    // Upper Hemisphere - Hemi-octahedron
    float hx = (cx + cy) * 0.5;
    float hy = (cx - cy) * 0.5;
    float hz = 1.0 - abs(hx) - abs(hy);
    dir = normalize(set(hx, hy, hz));
    dir = set(dir.x, dir.z, dir.y);

} else {
    // Turntable
    int total = N * N;
    float angle = radians(360.0 - (360.0 / float(total)) * float(i));
    dir = normalize(set(sin(angle), 0, cos(angle)));
}

// === POSITION ===
@P = dir * distance;
@N = dir;

// === ORIENTATION with stable up ===
vector world_up = set(0, 1, 0);
vector right = normalize(cross(world_up, dir));

// Pole fix
if (length(right) < 0.001) {
    right = set(1, 0, 0);
}

vector up = normalize(cross(dir, right));

// Build matrix: X=right, Y=up, Z=dir (outward)
matrix3 m = set(right, up, dir);
@orient = quaternion(m);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
grid_size	[ 0	locks=0 ]	(	[ grid_size	0 ] 	)
radius	[ 0	locks=0 ]	(	[ radius	0 ] 	)
mode	[ 0	locks=0 ]	(	[ mode	0 ] 	)
}

