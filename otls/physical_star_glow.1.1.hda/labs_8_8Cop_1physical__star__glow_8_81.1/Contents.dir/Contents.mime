Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"#bind layer src? val=0
#bind layer !&dst 

@KERNEL
{
    float2 ixy = convert_float2(@ixy);
    float2 res = convert_float2(@res);
    
    float2 pos = fmod(ixy + res / 2.0f, res);
    
    @dst.set(
        @src.bufferSample(pos)
    );
}
"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
