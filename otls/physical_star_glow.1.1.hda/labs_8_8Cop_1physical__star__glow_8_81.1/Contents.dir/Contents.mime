--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/opencl5.chn"
Content-Type: text/plain

{
    channel bindings1_fval {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"./diff_scale\") }
    }
    channel diff_scale {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../diffractionscale\")/ch(\"../iterations\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/opencl5.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"#bind layer re
#bind layer im? val = 0
#bind layer a? val = 1.05

#bind layer &re_out
#bind layer &im_out
#bind parm diff_scale
@KERNEL
{
    const float2 size = @re.res;
    const float2 outputPixel = convert_float2(@ixy);

    // Center DC ON の DC インデックス。
    // 偶数・奇数のどちらの解像度にも対応。
    const float2 dcPixel = floor(size * 0.5f);

    // 正の波長比：wavelength / referenceWavelength
    const float ratio = 1.0f - @diff_scale * @a.x;

    // 基準 OTF の参照位置。
    const float2 sourcePixel =
        dcPixel + ratio * (outputPixel - dcPixel);

    // 整数インデックスを、画素中心の Texture 座標へ変換。
    const float2 sourceUV =
        (sourcePixel + (float2)(0.5f, 0.5f)) / size;

    // 入力とは別の出力レイヤーへ書き込む。
    @re_out.set(@re.textureSample(sourceUV));
    @im_out.set(@im.textureSample(sourceUV));
}
"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	1	1	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
options_iterations	[ 0	locks=0 ]	(	1	)
options_iteration	[ 0	locks=0 ]	(	"off"	)
usewritebackkernel	[ 0	locks=0 ]	(	"off"	)
options_time	[ 0	locks=0 ]	(	"off"	)
options_timeinccontext	[ 0	locks=0 ]	(	"on"	)
options_timeinc	[ 0	locks=0 ]	(	"off"	)
options_timescale	[ 0	locks=0 ]	(	1	)
options_timemethod	[ 0	locks=0 ]	(	"invert"	)
options_importprequel	[ 0	locks=0 ]	(	"on"	)
options_timing	[ 0	locks=0 ]	(	"off"	)
cablerenamebylabel	[ 0	locks=0 ]	(	"off"	)
filter	[ 0	locks=0 ]	(	"box"	)
options_precision	[ 0	locks=0 ]	(	"32"	)
inputs	[ 0	locks=0 ]	(	3	)
parm_spacerparm	[ 0	locks=0 ]	(	)
outputs	[ 0	locks=0 ]	(	2	)
bindings	[ 0	locks=0 ]	(	1	)
displaycode	[ 0	locks=0 ]	(	0	)
generatedcode	[ 0	locks=0 ]	(	""	)
stdswitcher6	[ 0	locks=0 ]	(	0	0	0	0	0	)
folder_generatedparms_kernelcode	[ 0	locks=0 ]	(	0	)
diff_scale	[ 8	locks=0	minrange=-0.00161458	maxrange=1 ]	(	[ diff_scale	0 ] 	)
input1_name	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	re	)
input1_type	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"floatn"	)
input1_optional	[ 0	locks=0	autoscope=0	autosel=4294967295 ]	(	"off"	)
output1_name	[ 0	locks=0 ]	(	re_out	)
output1_type	[ 0	locks=0 ]	(	"floatn"	)
output1_metadata	[ 0	locks=0 ]	(	"first"	)
