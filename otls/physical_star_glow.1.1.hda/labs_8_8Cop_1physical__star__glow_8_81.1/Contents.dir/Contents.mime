{
    channel border {
      lefttype = extend
      righttype = extend
      default = 2
      flags = 0
      segment { length = 0 value = 2 2 expr = ch(\"../border\") }
    }
    channel xy_texturex {
      lefttype = extend
      righttype = extend
      default = -0.5
      flags = 0
      segment { length = 0 value = -0.5 -0.5 expr = -ch(\"../padding\") }
    }
    channel xy_texturey {
      lefttype = extend
      righttype = extend
      default = -0.5
      flags = 0
      segment { length = 0 value = -0.5 -0.5 expr = -ch(\"../padding\") }
    }
    channel rt_texturex {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = 1+ch(\"../padding\") }
    }
    channel rt_texturey {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = 1+ch(\"../padding\") }
    }
  }

