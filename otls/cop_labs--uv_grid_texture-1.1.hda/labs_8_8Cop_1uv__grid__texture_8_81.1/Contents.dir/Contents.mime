--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/text_sop/text_and_color.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"int divisions = chi(\"divisions\");
int type = chi(\"type\");
int xuv = @ptnum % divisions;
int yuv = floor(@ptnum / divisions);

if (type == 0) {
    if ((xuv + yuv) % 2 == 0) {
        s@coords = sprintf(\"%c\", 65 + yuv);
    } else {
        s@coords = itoa(xuv + 1);
    }
} else if (type == 1) {
    s@coords = itoa(xuv) + \",\" + itoa(yuv);
}

// Text Color
int textcolor = chi(\"textcolor\");

if (textcolor == 0) {
    vector unicolor = chv(\"textunicolor\");
    @Cd = unicolor;
} else if (textcolor == 1) {
    vector color1 = chv(\"textchecker1color\");
    vector color2 = chv(\"textchecker2color\");
    @Cd = ((xuv + yuv) % 2 == 0) ? color1 : color2;
} else {
    int idx = (xuv + yuv) % divisions;
    float t = float(idx) / float(max(divisions - 1, 1));
    @Cd = chramp(\"gradient\", t);
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
divisions	[ 0	locks=0 ]	(	[ divisions	0 ] 	)
type	[ 8	locks=0 ]	(	[ type	0 ] 	)
textcolor	[ 8	locks=0 ]	(	[ textcolor	1 ] 	)
textunicolor	[ 0	locks=0 ]	(	[ textunicolorr	1 ] 	[ textunicolorg	1 ] 	[ textunicolorb	1 ] 	)
textchecker1color	[ 0	locks=0 ]	(	[ textchecker1colorr	0.38422 ] 	[ textchecker1colorg	0.388818 ] 	[ textchecker1colorb	0.413845 ] 	)
textchecker2color	[ 0	locks=0 ]	(	[ textchecker2colorr	0.150959 ] 	[ textchecker2colorg	0.145576 ] 	[ textchecker2colorb	0.162685 ] 	)
gradient	[ 8	locks=0 ]	(	[ gradient	5 ] 	)
gradient1pos	[ 0	locks=0 ]	(	[ gradient1pos	0 ] 	)
gradient1c	[ 0	locks=0 ]	(	[ gradient1cr	0 ] 	[ gradient1cg	0 ] 	[ gradient1cb	0 ] 	)
gradient1interp	[ 0	locks=0 ]	(	[ gradient1interp	1 ] 	)
gradient2pos	[ 0	locks=0 ]	(	[ gradient2pos	0 ] 	)
gradient2c	[ 0	locks=0 ]	(	[ gradient2cr	0 ] 	[ gradient2cg	0 ] 	[ gradient2cb	0 ] 	)
gradient2interp	[ 0	locks=0 ]	(	[ gradient2interp	1 ] 	)
gradient3pos	[ 0	locks=0 ]	(	[ gradient3pos	0 ] 	)
gradient3c	[ 0	locks=0 ]	(	[ gradient3cr	0 ] 	[ gradient3cg	0 ] 	[ gradient3cb	0 ] 	)
gradient3interp	[ 0	locks=0 ]	(	[ gradient3interp	1 ] 	)
gradient4pos	[ 0	locks=0 ]	(	[ gradient4pos	0 ] 	)
gradient4c	[ 0	locks=0 ]	(	[ gradient4cr	0 ] 	[ gradient4cg	0 ] 	[ gradient4cb	0 ] 	)
gradient4interp	[ 0	locks=0 ]	(	[ gradient4interp	1 ] 	)
gradient5pos	[ 0	locks=0 ]	(	[ gradient5pos	0 ] 	)
gradient5c	[ 0	locks=0 ]	(	[ gradient5cr	0 ] 	[ gradient5cg	0 ] 	[ gradient5cb	0 ] 	)
gradient5interp	[ 0	locks=0 ]	(	[ gradient5interp	1 ] 	)
}

