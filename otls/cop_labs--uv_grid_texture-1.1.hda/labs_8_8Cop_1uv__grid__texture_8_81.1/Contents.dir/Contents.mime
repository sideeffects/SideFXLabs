--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/opencl1.chn"
Content-Type: text/plain

{
    channel bindings1_intval {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"./divisions\") }
    }
    channel divisions {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../griddivisions\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/opencl1.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"#bind layer id val=int
#bind layer uv val=float4 writeable
#bind parm divisions int

@KERNEL
{
    int did = (int)@id.x;
    int col = did % @divisions;
    int row = did / @divisions;

    row = (@divisions - 1) - row;

    int idx = (col + row) % @divisions;
    float u = (float)idx / (float)max(@divisions - 1, 1) * 2.0 - 1.0;

    @uv.set((float4)(u, 0.0f, 0.0f, 0.0f));
}


// int divisions = chi(\"divisions\");
// int id = int(@id);
// int col = id % divisions;
// int row = floor(id / divisions);

// row = (divisions - 1) - row;

// int idx = (col + row) % divisions;

// @uv.x = float(idx) / float(max(divisions - 1, 1)) * 2.0 - 1.0;
// @uv.y = 0.0;"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	1	1	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
