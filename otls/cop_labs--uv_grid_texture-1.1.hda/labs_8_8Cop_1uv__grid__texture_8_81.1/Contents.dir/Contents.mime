Content-Disposition: attachment; filename="hdaroot/opencl1.def"
Content-Type: text/plain

comment ""
position -15.2417 -1.47
connectornextid 3
flags =  lock off model off template off footprint off xray off bypass off display off render off highlight off unload off savedata off compress off colordefault on exposed on lowdetail off mediumdetail off highdetail on
outputsNamed3
{
2 "output1"
}
inputsNamed3
{
0 	tilepattern1 3 1 "input1"
1 	tilepattern1 1 1 "input2"
}
inputs
{
0 	tilepattern1 2 1
1 	tilepattern1 1 1
}
stat
{
  create -1
  modify -1
  author christoss@cayuga.local
  access 0777
}
color UT_Color RGB 0.8 0.8 0.8 
delscript ""
exprlanguage hscript
end

