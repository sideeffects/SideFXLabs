Content-Type: text/plain

{
    channel sizex {
      lefttype = extend
      righttype = extend
      default = 10
      flags = 0
      segment { length = 0 value = 10 10 expr = "detail(-1, \"tile_max_scale\", 0)" }
    }
    channel sizey {
      lefttype = extend
      righttype = extend
      default = 10
      flags = 0
      segment { length = 0 value = 10 10 expr = "detail(-1, \"tile_max_scale\", 0)" }
    }
  }

