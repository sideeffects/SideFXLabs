Content-Disposition: attachment; filename="hdaroot/delete_random_panels.chn"
Content-Type: text/plain

{
    channel rangeend {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = $N }
    }
    channel filter {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = rand(@primnum+ch(\"../deletion_seed\"))<ch(\"../panel_deletion_chance\")/100 }
    }
  }

