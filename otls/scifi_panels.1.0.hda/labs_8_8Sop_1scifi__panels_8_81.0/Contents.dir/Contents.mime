Content-Disposition: attachment; filename="hdaroot/sop_lot_subdivision1.chn"
Content-Type: text/plain

{
    channel seed {
      lefttype = extend
      righttype = extend
      default = 4.3600000000000003
      flags = 0
      segment { length = 0 value = 4.3600000000000003 4.3600000000000003 expr = ch(\"../g_seed\") }
    }
    channel irregularity {
      lefttype = extend
      righttype = extend
      default = 0.33300000000000002
      flags = 0
      segment { length = 0 value = 0.33300000000000002 0.33300000000000002 expr = ch(\"../irregularity\") }
    }
    channel min_lot_size {
      lefttype = extend
      righttype = extend
      default = 0.0040000000000000001
      flags = 0
      segment { length = 0 value = 0.0040000000000000001 0.0040000000000000001 expr = ch(\"../min_lot_size\") }
    }
    channel vertical_bias {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../vertical_bias\") }
    }
    channel alignment {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../alignment\") }
    }
    channel cluster_lots {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../cluster_lots\") }
    }
    channel number_of_clusters {
      lefttype = extend
      righttype = extend
      default = 11
      flags = 0
      segment { length = 0 value = 11 11 expr = ch(\"../number_of_clusters\") }
    }
    channel vertical_packing {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../vertical_packing\") }
    }
  }

