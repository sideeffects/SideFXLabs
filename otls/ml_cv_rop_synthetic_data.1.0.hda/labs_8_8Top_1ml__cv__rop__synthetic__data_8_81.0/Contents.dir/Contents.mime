comment ""
position 4.92699 -18.1777
connectornextid 2
flags =  lock off model off template off footprint off xray off bypass off display off render off highlight off unload off savedata off compress off colordefault on exposed on
outputsNamed3
{
0 "output1"
}
inputsNamed3
{
1 	clean_render_attrs 1 1 "input1"
}
inputs
{
0 	clean_render_attrs 0 1
}
stat
{
  create -1
  modify -1
  author josh@joshs-macbook-pro.local
  access 0777
}
color UT_Color RGB 0.8 0.8 0.8 
delscript ""
exprlanguage hscript
end

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/image_compositor.spareparmdef"
Content-Type: text/plain

    groupsimple {
        name    "fd_cookcontrols"
        label   "Cook Controls"

        parm {
            name    "targettopnetwork"
            label   "Top Network"
            type    oppath
            invisible
            default { "../image_compositor/rop_comped_images" }
            help    "None"
            parmtag { "opfilter" "!!TOP!!" }
            parmtag { "oprelative" "." }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
        parm {
            name    "generatestatic"
            label   "Generate Static Work Items"
            type    button
            joinnext
            default { "0" }
            help    "Generates static work items in all nodes in the TOP network. None of the work items will be cooked, and dynamic nodes will do nothing"
            parmtag { "script_callback" "import nodegraphtopui; nodegraphtopui.generateStatic(kwargs['node'].parm('targettopnetwork').evalAsNode())" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
        parm {
            name    "cookbutton"
            label   "Cook Output Node"
            type    button
            joinnext
            default { "0" }
            help    "Cook the output node in the TOP network and any out-of-date nodes connected to it. If you want to recook all the nodes in the TOP network, click Dirty All first and then click this button"
            parmtag { "script_callback" "import nodegraphtopui; nodegraphtopui.cookOutputNode(kwargs['node'].parm('targettopnetwork').evalAsNode())" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
        parm {
            name    "dirtyall"
            label   "Dirty All"
            type    button
            joinnext
            default { "0" }
            help    "Dirties all the work items in all of the TOP nodes inside the network and marks every node inside the network as needing to recook"
            parmtag { "script_callback" "import nodegraphtopui; nodegraphtopui.dirtyAll(kwargs['node'].parm('targettopnetwork').evalAsNode(), False)" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
        parm {
            name    "cancelbutton"
            label   "Cancel Cook"
            type    button
            default { "0" }
            help    "If any nodes in the TOP network are currently cooking, cancels their cook"
            parmtag { "script_callback" "import nodegraphtopui; nodegraphtopui.cancelCook(kwargs['node'].parm('targettopnetwork').evalAsNode())" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
        parm {
            name    "deletefileoutputs"
            label   "Delete All File Outputs From Disk"
            type    button
            default { "0" }
            help    "Deletes all previous cook files from disk and then dirties all the work items in all of the TOP nodes inside the network."
            parmtag { "script_callback" "import nodegraphtopui; nodegraphtopui.dirtyAll(kwargs['node'].parm('targettopnetwork').evalAsNode(), True)" }
            parmtag { "script_callback_language" "python" }
            parmtag { "spare_category" "TOPCookControls" }
        }
    }

    parm {
        name    "servicename"
        label   "Service Name"
        type    string
        default { "cops" }
        help    "Specifies the name of the PDG service to use for cooking, typically 'cops' for multi-threaded operations like annotation output. New services can be created in the PDG Services Window."
        menureplace {
            [ "opmenu -l -a rop_comped_images pdg_servicename" ]
        }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "fgimages"
        label   "Foreground Images"
        type    file
        default { "`@aov_dir`*raw.exr" }
        help    "Images to use for the foreground, usually the dataset images rendered upstream. the default of 'aov_dir'_raw.exr works with the defaults of ROP Synthetic Data TOP"
        menureplace {
            [ "opmenu -l -a locate_renders pattern" ]
        }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "usebg"
        label   "Composite Backgrounds"
        type    toggle
        default { "0" }
        help    "Enables compositing each foreground image onto a random background image from a specified directory of backgrounds."
        range   { 0! 8 }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "bgimages"
        label   "Background Images"
        type    file
        default { "" }
        help    "If enabled takes a filepattern with filters for the backgrounds to randomly be composited. "
        hidewhen "{ usebg == 0 }"
        menureplace {
            [ "opmenu -l -a locate_backgrounds pattern" ]
        }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "useshadows"
        label   "Use Shadow Matte"
        type    toggle
        default { "0" }
        help    "Enables the use of a Shadow Matte set up in the `Synthetics Karma ROP` resulting in a shadow being composited to ground the object to its backplate."
        range   { 0! 8 }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "rendervarrange"
        label   "Render Variant Range"
        type    toggle
        joinnext
        default { "0" }
        help    "enables the use of variant range."
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "varrange"
        label   "Variant Range"
        type    integer
        nolabel
        size    2
        default { "1" "100" }
        help    "Specifies the range of variants to render, useful when distributing renders across multiple computers."
        hidewhen "{ rendervarrange == 0 }"
        range   { -1 1 }
        parmtag { "script_callback_language" "python" }
    }
    group {
        name    "fd_postcomp"
        label   "Post Comp"

        parm {
            name    "useclipping"
            label   "Enable Clipping"
            type    toggle
            default { "0" }
            help    "Enables clipping tab"
            range   { 0! 8 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "usegrain"
            label   "Enable Grain"
            type    toggle
            default { "0" }
            help    "Enables grain controls tab"
            range   { 0! 8 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "fillalpha"
            label   "Fill Alpha"
            type    toggle
            default { "1" }
            help    "Enables a process that ensures the output frames have no transparent pixels"
            range   { 0! 8 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        group {
            name    "fd_grade"
            label   "Grade"

            parm {
                name    "brightminmax_"
                label   "Brightness Min/Max"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Defines the allowable range for the brightness factor to be randomly applied per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "export_disable" "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "brightamount"
                label   "Brightness"
                type    float
                default { [ "@comped_bright" hscript-expr ] }
                help    "The scale factor to control how bright or dim the layer is. Higher values increase the brightness. Lower values decrease the brightness. Defaults to an expression controlled by the brightness min/max."
                range   { 0 2 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_1"
            label   "Levels"

            parm {
                name    "inputlevels_"
                label   "Input Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Adjusts black and white points to increase contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "gamma"
                label   "Gamma"
                type    float
                default { "1" }
                help    "Adjusts midrange balance"
                range   { 0.1 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "output_levels_"
                label   "Output Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Remaps the result of Input Levels and Gamma to reduce contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_2"
            label   "Blur"

            parm {
                name    "filter"
                label   "Filter"
                type    ordinal
                default { "gaussian" }
                help    "Selects between box blur and Gaussian blur."
                menu {
                    "box"       "Box"
                    "gaussian"  "Gaussian"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "readoutsidepixels"
                label   "Read Pixels outside Image"
                type    toggle
                default { "on" }
                help    "Defines edge of frame behavior"
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "units"
                label   "Units"
                type    ordinal
                default { "pixel" }
                help    "Defines the units that the diameter of the blur is expressed in"
                menu {
                    "image"     "Image"
                    "pixels"    "Pixels"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "blurminmax_"
                label   "Blur Min/Max"
                type    vector2
                size    2
                default { "0" "0" }
                help    "Defines the allowable range for the amount of blur to be randomized per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "size"
                label   "Size"
                type    float
                default { [ "@comped_blur" hscript-expr ] }
                help    "Defines the diameter of the blur. Defaults to an expression controlled by the blur min/max"
                range   { 0! 100 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "scalesize_"
                label   "Scale Size"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Disproportionately scales the blur on either axis"
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_3"
            label   "Clipping"
            hidewhentab "{ useclipping == 0 }"

            parm {
                name    "mask"
                label   "Mask"
                type    float
                default { "1" }
                help    "Blends the modified image with the unclipped image"
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "clipping_lowerlimit"
                label   "Lower Limit"
                type    float
                default { "0" }
                help    "Clips the black point in the render"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "clipping_upperlimit"
                label   "Upper Limit"
                type    float
                default { "1" }
                help    "Clips the white point in the render"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "clippingmethod"
                label   "Clamped Values"
                type    ordinal
                default { "clamp" }
                help    "Specifies how clamped values should be handled"
                menu {
                    "clamp" "Replace with Limit Value"
                    "black" "Replace with Black"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_4"
            label   "Grain"
            tabbreak
            hidewhentab "{ usegrain == 0 }"

            parm {
                name    "grainminmax_"
                label   "Grain Min/Max"
                type    vector2
                size    2
                default { "0" "0.01" }
                help    "Specifies the allowable range of grain amplitude to be randomized per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "grainamp"
                label   "Grain Amplitude"
                type    float
                default { [ "@grain_amt" hscript-expr ] }
                help    "Specifies the intensity of the grain. Defaults to an expression controlled by the Grain Min/Max values."
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "elementsize"
                label   "Element Size"
                type    log
                default { "0.002" }
                help    "The size, in image coordinates, of the basic element of the grain"
                range   { 0.001 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "contrast"
                label   "Contrast"
                type    float
                default { "0" }
                help    "Used to make the noise appear more extreme without exceeding the 0 to 1 range."
                range   { -1! 1! }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "grainseed"
                label   "Seed"
                type    integer
                default { "0" }
                help    "Randomizes the grain pattern"
                range   { 0 100 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "fd_postcomp_1"
        label   "Foreground Options"
        hidewhentab "{ usebg == 0 }"

        group {
            name    "fd_grade_fg"
            label   "Grade"

            parm {
                name    "brightminmax_fg_"
                label   "Brightness Min/Max"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Defines the allowable range for the brightness factor to be randomly applied per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "brightamount_fg"
                label   "Brightness"
                type    float
                default { [ "@fg_bright" hscript-expr ] }
                help    "The scale factor to control how bright or dim the layer is. Higher values increase the brightness. Lower values decrease the brightness. Defaults to an expression controlled by the brightness min/max."
                range   { 0 2 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_fg_1"
            label   "Levels"

            parm {
                name    "levels_fg"
                label   "Input Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Adjusts black and white points to increase contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "gamma_fg"
                label   "Gamma"
                type    float
                default { "1" }
                help    "Adjusts midrange balance"
                range   { 0.1 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outputlevels_fg"
                label   "Output Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Remaps the result of Input Levels and Gamma to reduce contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_fg_2"
            label   "Blur"
            tabbreak

            parm {
                name    "filter_fg"
                label   "Filter"
                type    ordinal
                default { "gaussian" }
                help    "Selects between box blur and Gaussian blur."
                menu {
                    "box"       "Box"
                    "gaussian"  "Gaussian"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "readoutsidepixels_fg"
                label   "Read Pixels outside Image"
                type    toggle
                default { "on" }
                help    "Defines edge of frame behavior"
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "units_fg"
                label   "Units"
                type    ordinal
                default { "image" }
                help    "Defines the units that the diameter of the blur is expressed in"
                menu {
                    "image"     "Image"
                    "pixels"    "Pixels"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "blurminmax_fg_"
                label   "Blur Min/Max"
                type    vector2
                size    2
                default { "0" "0" }
                help    "Defines the allowable range for the amount of blur to be randomized per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "size_fg"
                label   "Size"
                type    float
                default { [ "@fg_blur" hscript-expr ] }
                help    "Defines the diameter of the blur. Defaults to an expression controlled by the blur min/max"
                range   { 0! 100 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "scale_fg"
                label   "Scale Size"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Disproportionately scales the blur on either axis"
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "fd_postcomp_2"
        label   "Background Options"
        hidewhentab "{ usebg == 0 }"

        group {
            name    "fd_grade_bg"
            label   "Grade"

            parm {
                name    "brightminmax_bg"
                label   "Brightness Min/Max"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Defines the allowable range for the brightness factor to be randomly applied per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "brightamount_bg"
                label   "Brightness"
                type    float
                default { [ "@bg_bright" hscript-expr ] }
                help    "The scale factor to control how bright or dim the layer is. Higher values increase the brightness. Lower values decrease the brightness. Defaults to an expression controlled by the brightness min/max."
                range   { 0 2 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_bg_1"
            label   "Levels"

            parm {
                name    "levels_bg"
                label   "Input Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Adjusts black and white points to increase contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "gamma_bg"
                label   "Gamma"
                type    float
                default { "1" }
                help    "Adjusts midrange balance"
                range   { 0.1 10 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outputlevels_bg"
                label   "Output Levels"
                type    float
                size    2
                default { "0" "1" }
                help    "Remaps the result of Input Levels and Gamma to reduce contrast"
                range   { 0 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "fd_grade_bg_2"
            label   "Blur"

            parm {
                name    "filter_bg"
                label   "Filter"
                type    ordinal
                default { "gaussian" }
                help    "Selects between box blur and Gaussian blur."
                menu {
                    "box"       "Box"
                    "gaussian"  "Gaussian"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "readoutsidepixels_bg"
                label   "Read Pixels outside Image"
                type    toggle
                default { "on" }
                help    "Defines edge of frame behavior"
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "units_bg"
                label   "Units"
                type    ordinal
                default { "image" }
                help    "Defines the units that the diameter of the blur is expressed in"
                menu {
                    "image"     "Image"
                    "pixels"    "Pixels"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "blurminmax_bg_"
                label   "Blur Min/Max"
                type    vector2
                size    2
                default { "0" "0" }
                help    "Defines the allowable range for the amount of blur to be randomized per image."
                range   { -1 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "size_bg"
                label   "Size"
                type    float
                default { [ "@bg_blur" hscript-expr ] }
                help    "Defines the diameter of the blur. Defaults to an expression controlled by the blur min/max"
                range   { 0! 100 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "scale_bg"
                label   "Scale Size"
                type    vector2
                size    2
                default { "1" "1" }
                help    "Disproportionately scales the blur on either axis"
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }


