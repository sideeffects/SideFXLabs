Content-Disposition: attachment; filename="hdaroot/frame_range.chn"
Content-Type: text/plain

{
    channel floatrange1x {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../f1\") }
    }
    channel wedgecount {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = (ch(\"../f2\")-ch(\"../f1\")+1)/ch(\"../f3\") }
    }
    channel floatrange1y {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../f2\") }
    }
    channel intrange1x {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../f1\") }
    }
    channel intrange1y {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../f2\") }
    }
    channel seed {
      lefttype = extend
      righttype = extend
      default = 1438
      flags = 0
      segment { length = 0 value = 1438 1438 expr = @variant+ch(\"../dsseed\")+35 }
    }
  }

