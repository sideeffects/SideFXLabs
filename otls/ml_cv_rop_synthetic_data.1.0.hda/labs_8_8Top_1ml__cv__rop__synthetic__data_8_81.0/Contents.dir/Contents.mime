{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"#bind layer src? val=0
#bind layer !&dst

#bind parm min1 float val=0
#bind parm max1 float val=1

@KERNEL
{
    float4 src = (float4)(
        fit01(@src.x,@min1,@max1), 
        fit01(@src.y,@min1,@max1), 
        fit01(@src.z,@min1,@max1), 
        @src.w);

    @dst.set(src);
}
"	)
