Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	0	)
inprocess	[ 0	locks=0 ]	(	"on"	)
pdgservicename	[ 0	locks=0 ]	(	pythonscript	)
sepparm2	[ 0	locks=0 ]	(	)
evaluation	[ 0	locks=0 ]	(	1	)
pdg_workitemgeneration	[ 0	locks=0 ]	(	"2"	)
pdg_cooktype	[ 0	locks=0 ]	(	"0"	)
pdg_useserviceblock	[ 0	locks=0 ]	(	"1"	)
pdg_servicename	[ 0	locks=0 ]	(	pythonscript	)
manageservices	[ 0	locks=0 ]	(	0	)
pdg_servicereset	[ 0	locks=0 ]	(	"0"	)
pdg_serviceresetwhen	[ 0	locks=0 ]	(	"1"	)
exectuable	[ 0	locks=0 ]	(	0	)
pythonbin	[ 0	locks=0 ]	(	"0"	)
python	[ 0	locks=0 ]	(	__PDG_PYTHON__	)
pythonvenv	[ 0	locks=0 ]	(	`@venvroot`	)
resetpython	[ 0	locks=0 ]	(	"off"	)
nativeworkitem	[ 0	locks=0 ]	(	"off"	)
sepparm3	[ 0	locks=0 ]	(	)
pythonargs	[ 0	locks=0 ]	(	-u	)
extraargs	[ 0	locks=0 ]	(	""	)
sepparm	[ 0	locks=0 ]	(	)
pythonpaths	[ 0	locks=0 ]	(	0	)
batching	[ 0	locks=0 ]	(	0	)
batchtype	[ 0	locks=0 ]	(	"0"	)
scripttype	[ 0	locks=0 ]	(	"0"	)
batchactivation	[ 0	locks=0 ]	(	"0"	)
batchsize	[ 0	locks=0 ]	(	1	)
prescript	[ 0	locks=0 ]	(	"# Script code that runs once before a batch begins.
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
#
# In addition to the above, in-process scripts can also access:
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
"	)
expansion	[ 0	locks=0 ]	(	0	)
expandscript	[ 0	locks=0 ]	(	"off"	)
expandstrings	[ 0	locks=0 ]	(	"off"	)
script	[ 0	locks=0 ]	(	"import hou

##get all the params from annotation multiparm
py_node = hou.node('.')
catmultiparm = py_node.parm('categories')
catinstances = catmultiparm.multiParmInstances()
catnames = catinstances[::2]

##Get all user specified categories
cats = []

for x in catnames:
    cats.append(x.eval()) 

##Get all use specified attributes
for cat in range(len(catnames)):
    attrs = []
    parm = 'annotation' + str(cat+1)
    attrmultiparm = py_node.parm(parm)
    attrinstances = attrmultiparm.multiParmInstances()
    for y in attrinstances:
        attrs.append(y.eval()) 
    attrs = str(attrs)
    work_item.setStringAttrib(cats[cat], attrs)

cats = str(cats)
work_item.setStringAttrib(\"categories\", cats)"	)
pdg_cachemode	[ 0	locks=0 ]	(	"0"	)
copyoutputs	[ 0	locks=0 ]	(	"2"	)
sepparm5	[ 0	locks=0 ]	(	)
expectedoutputsfrom	[ 0	locks=0 ]	(	"0"	)
expectedoutputattr	[ 0	locks=0 ]	(	""	)
useexpectedoutputtag	[ 0	locks=0 ]	(	"off"	)
expectedoutputtag	[ 0	locks=0 ]	(	file	)
expectedoutputfiles	[ 0	locks=0 ]	(	0	)
expectedscript	[ 0	locks=0 ]	(	"# Script code that runs for each task to assign expectd outputs
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
#
# For example:
#
# work_item.addExpectedOutputFile(
#     \"example.{}.txt\".format(work_item.index),
#     tag=\"file/txt\")"	)
topscheduler	[ 0	locks=0 ]	(	""	)
addjobparms	[ 0	locks=0 ]	(	0	)
pdg_useschedulewhen	[ 0	locks=0 ]	(	"off"	)
pdg_schedulewhen	[ 0	locks=0 ]	(	1	)
sepparm4	[ 0	locks=0 ]	(	)
pdg_workitemlabel	[ 0	locks=0 ]	(	"0"	)
pdg_workitemlabelexpr	[ 0	locks=0 ]	(	""	)
pdg_workitempriority	[ 0	locks=0 ]	(	"0"	)
pdg_workitempriorityexpr	[ 0	locks=0 ]	(	0	)
pdg_commandtype	[ 0	locks=0 ]	(	"0"	)
pdg_command	[ 0	locks=0 ]	(	""	)
folder1	[ 0	locks=0 ]	(	0	0	0	0	)
evaluation2	[ 0	locks=0 ]	(	1	)
exectuable2	[ 0	locks=0 ]	(	0	)
batching2	[ 0	locks=0 ]	(	0	)
expansion2	[ 0	locks=0 ]	(	0	)
categories	[ 0	locks=0 ]	(	[ categories	0 ] 	)
}

