pdg_servicename	[ 0	locks=0 ]	(	pythonscript	)
manageservices	[ 0	locks=0 ]	(	0	)
pdg_servicereset	[ 0	locks=0 ]	(	"0"	)
pdg_serviceresetwhen	[ 0	locks=0 ]	(	"1"	)
exectuable	[ 0	locks=0 ]	(	1	)
pythonbin	[ 0	locks=0 ]	(	"3"	)
python	[ 0	locks=0 ]	(	`@localpy`	)
pythonvenv	[ 0	locks=0 ]	(	`@venvroot_core`	)
resetpython	[ 0	locks=0 ]	(	[ resetpython	0 ] 	)
nativeworkitem	[ 0	locks=0 ]	(	"off"	)
sepparm3	[ 0	locks=0 ]	(	)
pythonargs	[ 0	locks=0 ]	(	-u	)
extraargs	[ 0	locks=0 ]	(	""	)
sepparm	[ 0	locks=0 ]	(	)
pythonpaths	[ 0	locks=0 ]	(	0	)
batching	[ 0	locks=0 ]	(	0	)
batchtype	[ 0	locks=0 ]	(	"0"	)
scripttype	[ 0	locks=0 ]	(	"0"	)
batchactivation	[ 0	locks=0 ]	(	"0"	)
batchsize	[ 0	locks=0 ]	(	1	)
prescript	[ 0	locks=0 ]	(	"# Script code that runs once before a batch begins.
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
#
# In addition to the above, in-process scripts can also access:
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
"	)
expansion	[ 0	locks=0 ]	(	1	)
expandscript	[ 0	locks=0 ]	(	"on"	)
expandstrings	[ 0	locks=0 ]	(	"off"	)
script	[ 0	locks=0 ]	(	"import OpenEXR
import Imath
import numpy as np

# Get the current exr image and map it to the corresponding depth image
exr_file = '`@files`'
depth_img_name = '`@filename`'.replace('_ID','_depth')
npy_name = '{}.npy'.format(depth_img_name)
directory = '`@directory`'

# Path to your EXR file
exr_file_path = os.path.join(directory,depth_img_name + '.exr')
print(exr_file_path)

# Ensure OpenEXR file can be opened
if OpenEXR.isOpenExrFile(exr_file_path):
    exr_file = OpenEXR.InputFile(exr_file_path)
    
    # Specify the channel you wish to extract (e.g., 'Z' for depth)
    channel = 'depth.depth'
    dw = exr_file.header()['dataWindow']
    size = (dw.max.x - dw.min.x + 1, dw.max.y - dw.min.y + 1)
    
    # Format specifier for 32-bit float
    pt = Imath.PixelType(Imath.PixelType.FLOAT)
    raw_data = exr_file.channel(channel, pt)
    
    # Convert raw data to numpy array
    depth_array = np.frombuffer(raw_data, dtype=np.float32)
    depth_array.shape = (size[1], size[0])  # Reshape the array to the image size
    
    # Save the numpy array to a .npy file
    np.save(os.path.join(directory.replace('/exr', ''), npy_name), depth_array)
else:
    print(\"Failed to open EXR file.\")"	)
pdg_cachemode	[ 0	locks=0 ]	(	"0"	)
copyoutputs	[ 0	locks=0 ]	(	"2"	)
sepparm5	[ 0	locks=0 ]	(	)
expectedoutputsfrom	[ 0	locks=0 ]	(	"0"	)
expectedoutputattr	[ 0	locks=0 ]	(	""	)
useexpectedoutputtag	[ 0	locks=0 ]	(	"off"	)
expectedoutputtag	[ 0	locks=0 ]	(	file	)
expectedoutputfiles	[ 0	locks=0 ]	(	0	)
expectedscript	[ 0	locks=0 ]	(	"# Script code that runs for each task to assign expectd outputs
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
#
# For example:
#
