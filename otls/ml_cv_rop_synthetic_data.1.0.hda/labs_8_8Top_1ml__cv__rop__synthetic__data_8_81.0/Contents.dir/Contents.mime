    parm {
        name    "from3"
        label   "Input Levels"
        type    float
        size    2
        default { "1" "0" }
        range   { 0 1 }
        export  all
    }
    parm {
        name    "gamma2"
        label   "Gamma"
        type    log
        default { "1" }
        range   { 0.1 10 }
        export  all
    }
    parm {
        name    "to3"
        label   "Output Levels"
        type    float
        size    2
        default { "1" "0" }
        range   { 0 1 }
        export  all
    }
    parm {
        name    "sep7"
        label   "sep7"
        type    separator
        default { "" }
    }
    multiparm {
        name    "inputs"
        label    "Inputs"
        baseparm
        default 0

        parm {
            name    "inputlabel#"
            baseparm
            label   "Input Label"
            export  none
        }
        parm {
            name    "inputtype#"
            baseparm
            label   "Input Type"
            export  none
        }
    }

    multiparm {
        name    "outputs"
        label    "Outputs"
        baseparm
        default 0

        parm {
            name    "outputlabel#"
            baseparm
            label   "Output Label"
            export  none
        }
        parm {
            name    "outputtype#"
            baseparm
            label   "Output Type"
            export  none
        }
    }


