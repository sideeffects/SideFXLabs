    parm {
        name    "from3"
        label   "Input Levels"
        type    float
        size    2
        default { "1" "0" }
        range   { 0 1 }
        export  all
    }
    parm {
        name    "gamma2"
        label   "Gamma"
        type    log
        default { "1" }
        range   { 0.1 10 }
        export  all
    }
    parm {
        name    "to3"
        label   "Output Levels"
        type    float
        size    2
        default { "1" "0" }
        range   { 0 1 }
        export  all
    }
    parm {
        name    "sep7"
        label   "sep7"
        type    separator
        default { "" }
    }
    multiparm {
        name    "inputs"
        label    "Inputs"
        baseparm
        default 0

        parm {
            name    "inputlabel#"
            baseparm
            label   "Input Label"
            export  none
        }
        parm {
            name    "inputtype#"
            baseparm
            label   "Input Type"
            export  none
        }
    }

    multiparm {
        name    "outputs"
        label    "Outputs"
        baseparm
        default 0

        parm {
            name    "outputlabel#"
            baseparm
            label   "Output Label"
            export  none
        }
        parm {
            name    "outputtype#"
            baseparm
            label   "Output Type"
            export  none
        }
    }


--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/image_compositor/compositing/fg_levels.chn"
Content-Type: text/plain

{
    channel from31 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../levels_fg1\") }
    }
    channel from32 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../../levels_fg2\") }
    }
    channel to31 {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../../outputlevels_fg1\") }
    }
    channel to32 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../../outputlevels_fg2\") }
    }
    channel gamma2 {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../../gamma_fg\") }
    }
  }

