    group {
        name    "folder1"
        label   "Script"
        grouptag { "sidefx::switcher" "folder0" }

        parm {
            name    "inprocess"
            baseparm
            label   "Evaluate Script During"
            invisible
            export  none
        }
        parm {
            name    "pdgservicename"
            baseparm
            label   "Service Name"
            invisible
            export  none
        }
        parm {
            name    "sepparm2"
            baseparm
            label   "Separator"
            invisible
            export  none
        }
        groupcollapsible {
            name    "evaluation2"
            label   "Script Evaluation"
            parmtag { "group_default" "1" }
            grouptag { "sidefx::switcher" "evaluation" }

            parm {
                name    "pdg_workitemgeneration"
                baseparm
                label   "Generate When"
                export  none
            }
            parm {
                name    "pdg_cooktype"
                baseparm
                label   "Evaluate Script During"
                export  none
            }
            parm {
                name    "pdg_useserviceblock"
                baseparm
                label   "Run on Service Block"
                export  none
            }
            parm {
                name    "pdg_servicename"
                baseparm
                label   "Service Name"
                joinnext
                export  none
            }
            parm {
                name    "manageservices"
                baseparm
                label   "Manage Services..."
                export  none
            }
            parm {
                name    "pdg_servicereset"
                baseparm
                label   "Reset Service"
                joinnext
                export  none
            }
            parm {
                name    "pdg_serviceresetwhen"
                baseparm
                label   "Reset Service When"
                nolabel
                export  none
            }
        }

        groupcollapsible {
            name    "exectuable2"
            label   "Python Executable"
            disablewhen "{ pdg_cooktype != 2 }"
            grouptag { "sidefx::switcher" "exectuable" }

            parm {
                name    "pythonbin"
                baseparm
                label   "Python Bin"
                export  none
            }
            parm {
                name    "python"
                baseparm
                label   "Custom Python Bin"
                export  none
            }
            parm {
                name    "pythonvenv"
                baseparm
                label   "Venv Path"
                export  none
            }
            parm {
                name    "resetpython"
                baseparm
                label   "Reset Python Path Variables"
                export  none
            }
            parm {
                name    "nativeworkitem"
                baseparm
                label   "Load as Native Work Item"
                export  none
            }
            parm {
                name    "sepparm3"
                baseparm
                label   "Separator"
                export  none
            }
            parm {
                name    "pythonargs"
                baseparm
                label   "Python Arguments"
                export  none
            }
            parm {
                name    "extraargs"
                baseparm
                label   "Script Arguments"
                export  none
            }
        }

        groupcollapsible {
            name    "batching2"
            label   "Batching"
            disablewhen "{ pdg_cooktype == 0 } { pdg_cooktype == 3 }"
            grouptag { "sidefx::switcher" "batching" }

            parm {
                name    "batchtype"
                baseparm
                label   "Batch Type"
                export  none
            }
            parm {
                name    "scripttype"
                baseparm
                label   "Run Script Code"
                export  none
            }
            parm {
                name    "batchsize"
                baseparm
                label   "Batch Size"
                export  none
            }
            parm {
                name    "prescript"
                baseparm
                label   "Setup Script"
                export  none
            }
        }

        groupcollapsible {
            name    "expansion2"
            label   "Variable Expansion"
            grouptag { "sidefx::switcher" "expansion" }

            parm {
                name    "expandscript"
                baseparm
                label   "Expand Variables in Script"
                export  none
            }
            parm {
                name    "expandstrings"
                baseparm
                label   "Expand Variables in String Attributes"
                export  none
            }
        }

        parm {
            name    "script"
            baseparm
            label   "Python Code"
            export  none
        }
    }

    group {
        name    "folder1_1"
        label   "Caching and Output Files"

        parm {
            name    "pdg_cachemode"
            baseparm
            label   "Cache Mode"
            export  none
        }
        parm {
            name    "copyoutputs"
            baseparm
            label   "Copy Inputs to Outputs"
            export  none
        }
        parm {
            name    "sepparm5"
            baseparm
            label   "Separator"
            export  none
        }
        parm {
            name    "expectedoutputsfrom"
            baseparm
            label   "Expected Outputs From"
            export  none
        }
        parm {
            name    "expectedoutputattr"
            baseparm
            label   "Attribute Name"
            export  none
        }
        parm {
            name    "useexpectedoutputtag"
            baseparm
            label   "Use Custom Tag"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "expectedoutputtag"
            baseparm
            label   "Custom File Tag"
            export  none
        }
        multiparm {
            name    "expectedoutputfiles"
            label    "Expected Outputs"
            baseparm
            hidewhen "{ expectedoutputsfrom != 2 }"

            parm {
                name    "expectedoutputfile#"
                baseparm
                label   "Output File"
                export  none
            }
            parm {
                name    "useexpectedoutputtag#"
                baseparm
                label   "Use Custom Tag"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "expectedoutputtag#"
                baseparm
                label   "Custom File Tag"
                export  none
            }
        }

    }

    group {
        name    "folder1_2"
        label   "Schedulers"

        parm {
            name    "topscheduler"
            baseparm
            label   "TOP Scheduler Override"
            joinnext
            export  none
        }
        parm {
            name    "addjobparms"
            baseparm
            label   "Add Job Parms"
            nolabel
            export  none
        }
        parm {
            name    "pdg_useschedulewhen"
            baseparm
            label   "Use Schedule When"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "pdg_schedulewhen"
            baseparm
            label   "Schedule When"
            export  none
        }
        parm {
            name    "sepparm4"
            baseparm
            label   "Separator"
            export  none
        }
        parm {
            name    "pdg_workitemlabel"
            baseparm
            label   "Work Item Label"
            joinnext
            export  none
        }
        parm {
            name    "pdg_workitemlabelexpr"
            baseparm
            label   "Label Expression"
            nolabel
            export  none
        }
        parm {
            name    "pdg_workitempriority"
            baseparm
            label   "Work Item Priority"
            joinnext
            export  none
        }
        parm {
            name    "pdg_workitempriorityexpr"
            baseparm
            label   "Priority Expression"
            nolabel
            export  none
        }
    }

    group {
        name    "folder1_3"
        label   "Validation Attrs"

        multiparm {
            name    "categories"
            label    "Category"

            parm {
                name    "cat_name#"
                label   "Category Name"
                type    string
                default { "" }
                parmtag { "script_callback_language" "python" }
            }
            multiparm {
                name    "annotation#"
                label    "Annotation Property"

                parm {
                    name    "anotation_name#_#"
                    label   "Annotation"
                    type    string
                    default { "" }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

    }

    parm {
        name    "sepparm"
        baseparm
        label   "Separator"
        export  none
    }
    multiparm {
        name    "pythonpaths"
        label    "Extra Module Paths"
        baseparm

        parm {
            name    "pathsource#"
            baseparm
            label   "Path Type"
            export  none
        }
        parm {
            name    "custompath#"
            baseparm
            label   "Custom Path"
            export  none
        }
        parm {
            name    "venvpath#"
            baseparm
            label   "Venv Path"
            export  none
        }
        parm {
            name    "sepparm6_#"
            baseparm
            label   "Separator"
            export  none
        }
    }

    parm {
        name    "batchactivation"
        baseparm
        label   "Cook Batch When"
        export  none
    }
    parm {
        name    "pdg_commandtype"
        baseparm
        label   "Work Item Command"
        export  none
    }
    parm {
        name    "pdg_command"
        baseparm
        label   "Custom Command"
        nolabel
        export  none
    }
    parm {
        name    "expectedscript"
        baseparm
        label   "Expected Outputs Script"
        export  none
    }

