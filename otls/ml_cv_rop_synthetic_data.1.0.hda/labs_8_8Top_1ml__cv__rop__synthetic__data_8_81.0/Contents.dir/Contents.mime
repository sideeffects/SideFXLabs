Content-Type: text/plain

    groupsimple {
        name    "folder3"
        label   "Create"

        parm {
            name    "pdg_workitemgeneration"
            baseparm
            label   "Generate When"
            export  none
        }
        parm {
            name    "usecondition"
            baseparm
            label   "Use Condition"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "condition"
            baseparm
            label   "Create When"
            export  none
        }
    }

    groupsimple {
        name    "folder4"
        label   "Work Item"

        parm {
            name    "copyoutputs"
            baseparm
            label   "Copy Inputs to Outputs"
            export  none
        }
        parm {
            name    "pdg_workitempriority"
            baseparm
            label   "Work Item Priority"
            export  none
        }
        parm {
            name    "pdg_workitempriorityexpr"
            baseparm
            label   "Priority Expression"
            export  none
        }
        parm {
            name    "useindex"
            baseparm
            label   "useindex"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "indexvalue"
            baseparm
            label   "Index"
            export  none
        }
        parm {
            name    "useframe"
            baseparm
            label   "useframe"
            nolabel
            joinnext
            export  none
        }
        parm {
            name    "framevalue"
            baseparm
            label   "Frame"
            export  none
        }
        parm {
            name    "usepriority"
            baseparm
            label   "usepriority"
            nolabel
            invisible
            joinnext
            export  none
        }
        parm {
            name    "priorityvalue"
            baseparm
            label   "Priority"
            invisible
            export  none
        }
    }

    groupsimple {
        name    "folder5"
        label   "Attributes"

        multiparm {
            name    "stringattribs"
            label    "Strings"
            baseparm

            parm {
                name    "stringenable#"
                baseparm
                label   "String Enable"
                nolabel
                joinnext
                export  none
            }
            parm {
                name    "stringname#"
                baseparm
                label   "Name"
                export  none
            }
            parm {
                name    "stringconflict#"
                baseparm
                label   "Existing Name"
                export  none
            }
            parm {
                name    "stringscope#"
                baseparm
                label   "Scope"
                export  none
            }
            parm {
                name    "stringvalue#"
                baseparm
                label   "Value"
                export  none
            }
            parm {
