Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	0	)
inprocess	[ 0	locks=0 ]	(	"on"	)
pdgservicename	[ 0	locks=0 ]	(	pythonscript	)
sepparm2	[ 0	locks=0 ]	(	)
evaluation	[ 0	locks=0 ]	(	1	)
pdg_workitemgeneration	[ 0	locks=0 ]	(	"2"	)
pdg_cooktype	[ 0	locks=0 ]	(	"1"	)
pdg_useserviceblock	[ 0	locks=0 ]	(	"1"	)
pdg_servicename	[ 0	locks=0 ]	(	pythonscript	)
manageservices	[ 0	locks=0 ]	(	0	)
pdg_servicereset	[ 0	locks=0 ]	(	"0"	)
pdg_serviceresetwhen	[ 0	locks=0 ]	(	"1"	)
exectuable	[ 0	locks=0 ]	(	0	)
pythonbin	[ 0	locks=0 ]	(	"0"	)
python	[ 0	locks=0 ]	(	__PDG_PYTHON__	)
pythonvenv	[ 0	locks=0 ]	(	`@venvroot`	)
resetpython	[ 0	locks=0 ]	(	"off"	)
nativeworkitem	[ 0	locks=0 ]	(	"off"	)
sepparm3	[ 0	locks=0 ]	(	)
pythonargs	[ 0	locks=0 ]	(	""	)
extraargs	[ 0	locks=0 ]	(	""	)
sepparm	[ 0	locks=0 ]	(	)
pythonpaths	[ 0	locks=0 ]	(	0	)
batching	[ 0	locks=0 ]	(	0	)
batchtype	[ 0	locks=0 ]	(	"0"	)
scripttype	[ 0	locks=0 ]	(	"0"	)
batchactivation	[ 0	locks=0 ]	(	"0"	)
batchsize	[ 0	locks=0 ]	(	1	)
prescript	[ 0	locks=0 ]	(	"# Script code that runs once before a batch begins.
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
#
# In addition to the above, in-process scripts can also access:
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
"	)
expansion	[ 0	locks=0 ]	(	0	)
expandscript	[ 0	locks=0 ]	(	"on"	)
expandstrings	[ 0	locks=0 ]	(	"off"	)
script	[ 0	locks=0 ]	(	"import hou
import json
from datetime import date

# path to the output coco.json file
coco_json = '`@ds_dir`' + 'coco.json'

# get non-default image compositor parameters
node = hou.node('../image_compositor')
nondefaultparms = [parm for parm in node.parms() if not parm.isAtDefault()]

# Parse image comp parm names and values
augmentations = {}
for parm in nondefaultparms:
    if \"folder\" not in parm.name():
        augmentations[parm.name()] = parm.eval()

# Get dataset info values
py_node = hou.node('.')

versionx = py_node.parm('versionx').eval()
versiony = py_node.parm('versiony').eval()

contributor = py_node.parm('contributor').eval()
version = '{}.{}'.format(versionx, versiony)
description = py_node.parm('description').eval()
notes = py_node.parm('notes').eval()

lic_name = py_node.parm('lic_name').eval()
lic_url = py_node.parm('lic_url').eval()

glob_seed = py_node.parm('global_seed').eval()

# Open the JSON file and read its contents
with open(coco_json, 'r') as file:
    data = json.load(file)

# Check if 'info' key exists and is a dictionary
if 'info' in data and isinstance(data['info'], dict):

    data['info']['description'] = description
    data['info']['version'] = version
    data['info']['contributor'] = contributor
    data['info']['date_created'] = str(date.today())
    data['info']['notes'] = notes
    data['info']['global_seed'] = glob_seed
    
    # Add 'augmentations' array to the 'info' dictionary
    if nondefaultparms != []:
        data['info']['augmentations'] = []
        for parm in nondefaultparms:
            data['info']['augmentations'] = [augmentations]
         
else:
    print(\"'info' dictionary not found or not in expected format in JSON!\")

# Check if 'licenses' key exists and is a dictionary
if 'licenses' in data:
    licenses = {\"id\":1, \"name\":lic_name, \"url\":lic_url }
    data['licenses'] = licenses
    
else:
    print(\"'licenses' dictionary not found or not in expected format in JSON!\")

# Write the modified JSON string back to the file
with open(coco_json, 'w') as file:
    json.dump(data, file, indent=4)"	)
pdg_cachemode	[ 0	locks=0 ]	(	"0"	)
copyoutputs	[ 0	locks=0 ]	(	"2"	)
sepparm5	[ 0	locks=0 ]	(	)
expectedoutputsfrom	[ 0	locks=0 ]	(	"0"	)
expectedoutputattr	[ 0	locks=0 ]	(	""	)
useexpectedoutputtag	[ 0	locks=0 ]	(	"off"	)
expectedoutputtag	[ 0	locks=0 ]	(	file	)
expectedoutputfiles	[ 0	locks=0 ]	(	0	)
expectedscript	[ 0	locks=0 ]	(	"# Script code that runs for each task to assign expectd outputs
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
#
# For example:
