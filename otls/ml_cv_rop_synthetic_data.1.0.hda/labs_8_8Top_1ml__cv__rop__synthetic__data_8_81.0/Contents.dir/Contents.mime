--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/image_compositor/randomize_attributes.spareparmdef"
Content-Type: text/plain

    parm {
        name    "comboperinput"
        label   "Number of Combinations per Input"
        type    integer
        default { "1" }
        help    "Specifies the number of randomized variants to generate per input work item."
        range   { 0 10 }
        parmtag { "export_disable" "1" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "comboseed"
        label   "Combination Pool Seed"
        type    integer
        default { "7" }
        help    "Controls the randomization of attributes. Typically tied to the dataset seed for data generation."
        range   { 0 10 }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "copyname"
        label   "Attributes to Randomize"
        type    string
        default { "*" }
        help    "Specifies the attributes to randomize. By default, all attributes from the pool work item are included."
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "inputdistro"
        label   "Input Distribution"
        type    float
        default { "0" }
        help    "Controls the percentage usage of the 2nd and 3rd inputs when they are utilized."
        range   { 0! 1! }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "distroseed"
        label   "Distribution Seed"
        type    float
        default { "0" }
        help    "Controls the selection of work items in the distributed pool when using both the 2nd and 3rd inputs."
        range   { 0 10 }
        parmtag { "script_callback_language" "python" }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/image_compositor/randomize_attributes.chn"
Content-Type: text/plain

{
    channel comboseed {
      lefttype = extend
      righttype = extend
      default = 7
      flags = 0
      segment { length = 0 value = 7 7 expr = ch(\"../../ds_seed\") }
    }
  }

