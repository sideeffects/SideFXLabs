--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/compute_segmentation.spareparmdef"
Content-Type: text/plain

    parm {
        name    "data_pattern"
        label   "Data Pattern"
        type    file
        default { "`@aov_dir`*_ID.exr" }
        help    "Defines the file pattern used to locate the ID pass in the dataset folder. By default, it utilizes a PDG attribute generated upstream in the ROP Synthetic Data node."
        menureplace {
            [ "opmenu -l -a locate_renders pattern" ]
        }
        parmtag { "autoscope" "0000000000000000" }
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "depth_sw"
        label   "Depth Switch"
        type    toggle
        default { "0" }
        help    "Enabling this toggle generates a depth npy from the depth pass exr"
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "force_poly"
        label   "Force Polyseg"
        type    toggle
        default { "0" }
        help    "By default, this node uses RLE segmentation. Enabling this toggle forces the node to switch to a less efficient method that calculates the polygon outline for segmentation"
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "err_json"
        label   "Error for missing JSON"
        type    toggle
        default { "0" }
        help    "Fails work items if the ID pass does not have a corresponding json file."
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "sw_var_range"
        label   "Render Variant Range"
        type    toggle
        joinnext
        default { "0" }
        help    "Enables the use of variant range."
        parmtag { "script_callback_language" "python" }
    }
    parm {
        name    "var_range"
        label   "Variant Range"
        type    vector2
        nolabel
        size    2
        default { "0" "333" }
        help    "Retrieving data. Wait a few seconds and try to cut or copy again."
        hidewhen "{ sw_var_range == 0 }"
        range   { -1 1 }
        parmtag { "script_callback_language" "python" }
    }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/compute_segmentation.chn"
Content-Type: text/plain

{
    channel depth_sw {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enablez\") }
    }
    channel force_poly {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../forcepolyseg\") }
    }
    channel err_json {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../incompds\") }
    }
    channel sw_var_range {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../rendervarrange\") }
    }
    channel var_rangex {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../varrange1\") }
    }
    channel var_rangey {
      lefttype = extend
      righttype = extend
      default = 333
      flags = 0
      segment { length = 0 value = 333 333 expr = ch(\"../varrange2\") }
    }
  }

