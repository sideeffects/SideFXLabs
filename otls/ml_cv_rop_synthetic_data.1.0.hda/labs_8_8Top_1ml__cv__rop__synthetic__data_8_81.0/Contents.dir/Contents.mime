--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/compute_segmentation/compute_segmentation.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	0	)
inprocess	[ 0	locks=0 ]	(	"on"	)
pdgservicename	[ 0	locks=0 ]	(	pythonscript	)
sepparm2	[ 0	locks=0 ]	(	)
evaluation	[ 0	locks=0 ]	(	1	)
pdg_workitemgeneration	[ 0	locks=0 ]	(	"2"	)
pdg_cooktype	[ 0	locks=0 ]	(	"2"	)
pdg_useserviceblock	[ 0	locks=0 ]	(	"1"	)
pdg_servicename	[ 0	locks=0 ]	(	pythonscript	)
manageservices	[ 0	locks=0 ]	(	0	)
pdg_servicereset	[ 0	locks=0 ]	(	"0"	)
pdg_serviceresetwhen	[ 0	locks=0 ]	(	"1"	)
exectuable	[ 0	locks=0 ]	(	1	)
pythonbin	[ 0	locks=0 ]	(	"3"	)
python	[ 0	locks=0 ]	(	__PDG_PYTHON__	)
pythonvenv	[ 0	locks=0 ]	(	`@venvroot_core`	)
resetpython	[ 8	locks=0 ]	(	[ resetpython	0 ] 	)
nativeworkitem	[ 0	locks=0 ]	(	"off"	)
sepparm3	[ 0	locks=0 ]	(	)
pythonargs	[ 0	locks=0 ]	(	""	)
extraargs	[ 0	locks=0 ]	(	""	)
sepparm	[ 0	locks=0 ]	(	)
pythonpaths	[ 0	locks=0 ]	(	0	)
batching	[ 0	locks=0 ]	(	0	)
batchtype	[ 0	locks=0 ]	(	"0"	)
scripttype	[ 0	locks=0 ]	(	"0"	)
batchactivation	[ 0	locks=0 ]	(	"0"	)
batchsize	[ 0	locks=0 ]	(	1	)
prescript	[ 0	locks=0 ]	(	"# Script code that runs once before a batch begins.
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
#
# In addition to the above, in-process scripts can also access:
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
"	)
expansion	[ 0	locks=0 ]	(	1	)
expandscript	[ 0	locks=0 ]	(	"on"	)
expandstrings	[ 0	locks=0 ]	(	"off"	)
script	[ 0	locks=0 ]	(	"import argparse
import json
import numpy as np
import cv2
import pycocotools.mask as mask_util
import Imath
import OpenEXR
from datetime import datetime


def parse_args():
    parser = argparse.ArgumentParser(description='Extract masks from EXR and merge into COCO JSON')
    parser.add_argument('--exr', type=str, help='Path to the EXR file')
    parser.add_argument('--json', type=str, help='Path to the JSON file')
    parser.add_argument('--force-poly', action='store_true', help='Force polygonal segmentation over RLE')

    return parser.parse_args()


def read_masks_from_exr(exr):

    # Load the EXR file
    file = OpenEXR.File(exr)

    # Get the dimensions of the image
    dw_min, dw_max = file.header()['dataWindow']
    size = (dw_max[0] - dw_min[0] + 1, dw_max[1] - dw_min[1] + 1)
    
    # Get the ID channel name from the header
    for p in range(len(file.parts)):
        for name, channel in file.channels(p).items():
            if \"ID\" in name:
                id_channel = name
                break
     
    # Read ID channel data
    id_data = file.channels()[id_channel].pixels
    
    return id_data
        

def compute_poly_mask(binary, min_points: int = 3, contour_type: int = cv2.CHAIN_APPROX_SIMPLE):

    # Find contours around pixel values
    contours, hierarchy = cv2.findContours(binary, cv2.RETR_CCOMP, contour_type)  # cv2.CHAIN_APPROX_SIMPLE

    # Filter out very small contours
    filtered_contours = [contour for contour in contours if len(contour) >= min_points]

    # Loop through all contours and compute a polygon
    poly_segmentation = []
    for contour in filtered_contours:
        # Get polygonal approximation of the contour
        epsilon = 0.0001 * cv2.arcLength(contour, True)
        approx = cv2.approxPolyDP(contour, epsilon, True)

        # Get coordinates of polygon vertices
        vertices = approx.squeeze()
        vert_positions = []

        for vertex in vertices:
            # Check the shape of the vertices array
            x, y = vertex
            vert_positions.append(x.item())
            vert_positions.append(y.item())

        poly_segmentation.append(vert_positions)

    return poly_segmentation

def log_missing_file(missing_file):
    log_file=\"{}\\error.log\".format('`@ds_dir`')
    timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")
    with open(log_file, \"a\") as log:
        log.write(f\"{timestamp} - Missing file: {missing_file}\\n\")
        
def update_detection_gt(json_file, exr_file, force_poly=False):
    # Check if the JSON file exists
    if not os.path.exists(json_file):
        log_missing_file(json_file)
        print('missing json, skipping...')
        work_item.setIntAttrib(\"hasfailure\", 1)
        return
        
    # Open and read the per-render json file
    work_item.setIntAttrib(\"hasfailure\", 0)
    with open(json_file) as f:
        # Load the JSON data
        coco_data = json.load(f)
    
    # Read mask data from EXR file
    id_data = read_masks_from_exr(exr_file)
    
    # Compute bounding boxes for each unique pixel value
    for item in coco_data:
            
        # Get the coordinates of the pixels with this ID value
        b_mask = (id_data == item['hou_instance_id']).astype(np.uint8)

        if not np.any(b_mask):  # if this is an empty mask
            item.pop(\"bbox\", None)
            item.pop(\"segmentation\", None)
            item.pop(\"area\", None)
            continue

        rle_segmentation = mask_util.encode(np.asfortranarray(b_mask))
        rle_segmentation['counts'] = rle_segmentation['counts'].decode('utf-8')
        coco_bbox = mask_util.toBbox(rle_segmentation)

        # Add computed values to the array
        item[\"segmentation\"] = compute_poly_mask(b_mask) if force_poly else rle_segmentation
        item[\"bbox\"] = coco_bbox.tolist()
        item[\"area\"] = coco_bbox[2] * coco_bbox[3]
        item[\"iscrowd\"] = 0
        
    # Filter out items that do not have a 'bbox' key
    coco_data = [item for item in coco_data if 'bbox' in item]
    
    # Write json file
    with open(json_file, \"w\") as outfile:
        output_json = sorted(coco_data, key=lambda x: x[\"category_id\"])
        json.dump(output_json, outfile, indent=4)


def main():
    args = parse_args()
    
    exr_file = args.exr or '`@files`'
    
    if args.json:
        render_json_filepath = args.json
    else:
        filename = '`@filename`'.replace('_ID', '_rgba')
        directory = '`@directory`'
        json_name = '{}.json'.format(filename)
        render_json_filepath = directory.replace('exr', json_name)

    force_poly = bool(int('`@force_poly`'))
    update_detection_gt(render_json_filepath, exr_file, force_poly)
    

if __name__ == \"__main__\":
    main()
"	)
pdg_cachemode	[ 0	locks=0 ]	(	"0"	)
copyoutputs	[ 0	locks=0 ]	(	"2"	)
sepparm5	[ 0	locks=0 ]	(	)
expectedoutputsfrom	[ 0	locks=0 ]	(	"0"	)
expectedoutputattr	[ 0	locks=0 ]	(	""	)
useexpectedoutputtag	[ 0	locks=0 ]	(	"off"	)
expectedoutputtag	[ 0	locks=0 ]	(	file	)
expectedoutputfiles	[ 0	locks=0 ]	(	0	)
expectedscript	[ 0	locks=0 ]	(	"# Script code that runs for each task to assign expectd outputs
#
# The following variables are available:
# work_item    - the work item currently running 
# graph        - the graph attributes for the current work item
# self         - the current PDG node
# parent_item  - the parent work item, if it exists
#
# For example:
#
# work_item.addExpectedOutputFile(
#     \"example.{}.txt\".format(work_item.index),
#     tag=\"file/txt\")"	)
