--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/sopmodify1.chn"
Content-Type: text/plain

{
    channel importtime {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = $FF }
    }
    channel ineditlayerblock {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = hou.pwd().inputs()[0].inEditLayerBlock() language = python }
    }
    channel defineonlyleafprims {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = !ch(\"asreference\") }
    }
    channel setdefaultprim {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"asreference\") }
    }
    channel primpattern {
      lefttype = extend
      righttype = extend
      defaultString = \"%type:ParticleField3DGaussianSplat\"
      flags = 0
      segment { length = 0 expr = chs(\"../primpattern\") }
    }
    channel timesample {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../timesample\") }
    }
  }

