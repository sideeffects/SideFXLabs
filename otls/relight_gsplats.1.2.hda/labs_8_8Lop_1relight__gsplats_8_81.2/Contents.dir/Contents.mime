--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/sopmodify1/modify/modify/attribwrangle4.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"primitive"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"string stage = \"op:`chs(\"../lopimport_lights/loppath\")`\";
string path = prim(0, \"path\", @ptnum);
string shader_id = usd_attrib(stage, path, \"light:shaderId\");

if (shader_id != \"DomeLight\" &&
    shader_id != \"DistantLight\" &&
    shader_id != \"SphereLight\" &&
    shader_id != \"RectLight\" &&
    shader_id != \"DiskLight\" &&
    shader_id != \"CylinderLight\")
    return;

s@shader_id = shader_id;

matrix m = usd_worldtransform(stage, path);
v@light_pos = cracktransform(0, 0, 0, 0, m);

vector axis_vec = shader_id == \"CylinderLight\"
    ? set(getcomp(m, 0, 0), getcomp(m, 0, 1), getcomp(m, 0, 2))
    : set(getcomp(m, 2, 0), getcomp(m, 2, 1), getcomp(m, 2, 2));

v@light_dir = shader_id == \"CylinderLight\" ? axis_vec : -axis_vec;

v@light_color = usd_attrib(stage, path, \"inputs:color\");

if (usd_attrib(stage, path, \"inputs:enableColorTemperature\"))
{
    float k = clamp(usd_attrib(stage, path, \"inputs:colorTemperature\"), 1000, 40000);
    float t = k / 100.0;
    vector temp = t <= 66
        ? set(1, 0.3900815787 * log(t) - 0.6318414438, t <= 19 ? 0 : 0.5432067891 * log(t - 10) - 1.1962745098)
        : set(1.2929361860 * pow(t - 60, -0.1332047592), 1.1298908605 * pow(t - 60, -0.0755148492), 1);

    v@light_color *= clamp(temp, 0, 1);
}

f@intensity = usd_attrib(stage, path, \"inputs:intensity\");
f@exposure = usd_attrib(stage, path, \"inputs:exposure\");
f@diffuse = usd_attrib(stage, path, \"inputs:diffuse\");
f@specular = usd_attrib(stage, path, \"inputs:specular\");

f@radius = usd_attrib(stage, path, \"inputs:radius\");
if (f@radius == 0)
    f@radius = usd_attrib(stage, path, \"inputs:shaping:cone:softness\");

i@shadow_enable = usd_attrib(stage, path, \"inputs:shadow:enable\");

f@cylinder_length = shader_id == \"CylinderLight\"
    ? usd_attrib(stage, path, \"inputs:length\")
    : 0;

if (shader_id == \"DomeLight\")
{
    3@dome_rot = invert(matrix3(m));
    s@env_map_path = usd_attrib(stage, path, \"inputs:texture:file\");
}
"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
}

