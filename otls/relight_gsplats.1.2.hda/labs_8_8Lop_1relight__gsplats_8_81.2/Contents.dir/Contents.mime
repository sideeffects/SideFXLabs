--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/sopmodify1/modify/modify/attribwrangle1.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	""	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"#define GAMMA   2.2
#define INV_G   0.454545455
#define SH_C0   0.28209479177387814

function vector evalSH(vector dir; float sh_r[]; float sh_g[]; float sh_b[])
{
    int n = len(sh_r);
    if (n == 0) return vector(-1);
    float x = dir.x, y = dir.y, z = dir.z;
    float xx = x*x, yy = y*y, zz = z*z, xy = x*y, xz = x*z, yz = y*z;
    vector result = set(sh_r[0], sh_g[0], sh_b[0]) * SH_C0;
    
    if (n >= 4)
    {
        result += set(sh_r[1], sh_g[1], sh_b[1]) * (0.488603 * y);
        result += set(sh_r[2], sh_g[2], sh_b[2]) * (0.488603 * z);
        result += set(sh_r[3], sh_g[3], sh_b[3]) * (0.488603 * x);
    }
    
    if (n >= 9)
    {
        result += set(sh_r[4], sh_g[4], sh_b[4]) * (1.092548 * xy);
        result += set(sh_r[5], sh_g[5], sh_b[5]) * (1.092548 * yz);
        result += set(sh_r[6], sh_g[6], sh_b[6]) * (0.315392 * (2*zz - xx - yy));
        result += set(sh_r[7], sh_g[7], sh_b[7]) * (1.092548 * xz);
        result += set(sh_r[8], sh_g[8], sh_b[8]) * (0.546274 * (xx - yy));
    }
    
    if (n >= 16)
    {
        result += set(sh_r[9],  sh_g[9],  sh_b[9])  * (0.590044 * y * (3*xx - yy));
        result += set(sh_r[10], sh_g[10], sh_b[10]) * (2.890611 * xy * z);
        result += set(sh_r[11], sh_g[11], sh_b[11]) * (0.457046 * y * (4*zz - xx - yy));
        result += set(sh_r[12], sh_g[12], sh_b[12]) * (0.373176 * z * (2*zz - 3*xx - 3*yy));
        result += set(sh_r[13], sh_g[13], sh_b[13]) * (0.457046 * x * (4*zz - xx - yy));
        result += set(sh_r[14], sh_g[14], sh_b[14]) * (1.445306 * z * (xx - yy));
        result += set(sh_r[15], sh_g[15], sh_b[15]) * (0.590044 * x * (xx - 3*yy));
    }
    
    return result;
}

function vector sampleConvolvedSH(vector R; float rough; float sh_r[]; float sh_g[]; float sh_b[])
{
    vector up = abs(R.y) < 0.999 ? {0, 1, 0} : {1, 0, 0};
    vector T = normalize(cross(up, R));
    vector B = normalize(cross(R, T));
    float cone = rough * rough;
    vector dirs[] = array(
        R,
        normalize(R + T * cone),
        normalize(R - T * cone),
        normalize(R + B * cone),
        normalize(R - B * cone)
    );
    float weights[] = array(4, 1, 1, 1, 1);
    vector result = 0; float total = 0;
    for (int j = 0; j < 5; j++)
    {
        result += evalSH(dirs[j], sh_r, sh_g, sh_b) * weights[j];
        total += weights[j];
    }
    return result / max(total, 1e-6);
}

function float orenNayar(vector N; vector L; vector V; float roughness)
{
    float NL = max(0, dot(N,L));
    float NV = max(0, dot(N,V));
    
    float sigma2 = roughness * roughness;
    
    float A = 1 - (0.5 * sigma2 / (sigma2 + 0.33));
    float B = 0.45 * sigma2 / (sigma2 + 0.09);

    float theta_i = acos(clamp(NL, 0, 1));
    float theta_r = acos(clamp(NV, 0, 1));

    float alpha = max(theta_i, theta_r);
    float beta  = min(theta_i, theta_r);

    vector Li = normalize(L - N * NL);
    vector Vi = normalize(V - N * NV);
    
    float cos_phi = max(0, dot(Li, Vi));

    return clamp(A + B * cos_phi * sin(alpha) * tan(beta), 0, 2);
}

int num_lights = nprimitives(2);
if (num_lights == 0) return;

int has_sph =
    hasattrib(0, \"point\", \"GS_SPH_R\") &&
    hasattrib(0, \"point\", \"GS_SPH_G\") &&
    hasattrib(0, \"point\", \"GS_SPH_B\");

float sh_r[]; float sh_g[]; float sh_b[];

if (has_sph)
{
    sh_r = point(0, \"GS_SPH_R\", @ptnum);
    sh_g = point(0, \"GS_SPH_G\", @ptnum);
    sh_b = point(0, \"GS_SPH_B\", @ptnum);
    float spec_accum = 0;
    for (int i = 1; i < 4; i++)
    {
        spec_accum += (abs(sh_r[i]) + abs(sh_g[i]) + abs(sh_b[i]));
    }
    f@roughness = clamp(1 - (spec_accum * chf(\"sph_rough_bias\")), 0.05, 1);
}
else
{
    f@roughness = hasattrib(0, \"point\", \"roughness\") ? f@roughness * chf(\"roughness\") : chf(\"roughness\");
}

vector base_color = chv(\"base_color\");
vector alb;

if (has_sph)
{
    if (hasattrib(0, \"point\", \"albedo\"))
    {
        vector existing_albedo = v@albedo;
        alb = existing_albedo * base_color;
        v@albedo = alb;
    }
    else
    {
        vector sh_albedo = pow(clamp((set(sh_r[0], sh_g[0], sh_b[0]) * SH_C0) + 0.5, 0, 1), GAMMA);
        alb = sh_albedo * base_color;
        v@albedo = alb;
    }
}
else
{
    vector existing_albedo = hasattrib(0, \"point\", \"albedo\") ? v@albedo : (hasattrib(0, \"point\", \"Cd\") ? v@Cd : vector(1));
    alb = existing_albedo * base_color;
    v@albedo = alb;
}

vector N = normalize(@N);
vector V = normalize(prim(3, \"cam_pos\", 0) - @P);
float metal = hasattrib(0, \"point\", \"metalness\") ? f@metalness  * chf(\"metalness\") : chf(\"metalness\");
float ior = hasattrib(0, \"point\", \"ior\") ? f@ior : chf(\"ior\");
float ao = hasattrib(0, \"point\", \"ao\") ? f@ao : 1;
float emission = hasattrib(0, \"point\", \"emission\") ? f@emission : clamp(chf(\"emission\"), 0, 1);
vector emission_color = chv(\"emission_color\");
float specular = hasattrib(0, \"point\", \"specular\") ? f@specular * chf(\"specular\") : chf(\"specular\");
float rough = has_sph ? lerp(chf(\"roughness\"), @roughness, chf(\"sph_rough_gain\")) : f@roughness;
float diffuse_rough = clamp(chf(\"diffuse_roughness\"), 0, 1);

float r = max(rough, 0.03);
float a2 = r * r * r * r;
float f0_raw = pow((ior - 1) / (ior + 1), 2);
vector F0 = lerp(set(f0_raw), alb, metal);
float k_pbr = pow(rough + 1, 2) * 0.125;
float dotNV = max(1e-5, dot(N, V));
vector n_shade = normalize(lerp(N, V, chf(\"normal_softness\")));
float sph_blend = has_sph ? clamp((1 - chf(\"sph_blend\")), 0, 1) : 0;
vector sph_spec = 0;

if (has_sph)
{
    vector R = reflect(-V, N);
    vector sh_view = max(0, sampleConvolvedSH(R, rough, sh_r, sh_g, sh_b));
    vector F_sph = F0 + (1 - F0) * pow(max(0, 1 - dotNV), 5);
    sph_spec = sh_view * F_sph * pow(1 - rough, 2);
}

vector captured_color;
if (has_sph)
{
    captured_color = pow(clamp(set(sh_r[0], sh_g[0], sh_b[0]) * SH_C0 + 0.5, 0, 1), GAMMA);
}
else
{
    captured_color = alb;
}

vector accumulated_light = 0;
vector bbmin, bbmax;
getbbox(0, bbmin, bbmax);
vector size = bbmax - bbmin;
float scene_size = max(size.x, max(size.y, size.z));

for (int i = 0; i < num_lights; i++)
{
    string shader_id = prim(2, \"shader_id\", i);
    string env_path = prim(2, \"env_map_path\", i);
    matrix3 dome_rot = prim(2, \"dome_rot\", i);

    vector lDir = prim(2, \"light_dir\", i);
    vector lPos = prim(2, \"light_pos\", i);
    vector base_c = prim(2, \"light_color\", i);

    float intensity = prim(2, \"intensity\", i);
    float exposure = prim(2, \"exposure\", i);
    float diffuse = prim(2, \"diffuse\", i);
    float specular_mult = prim(2, \"specular\", i);
    float radius = prim(2, \"radius\", i);

    float lBase = intensity * pow(2, exposure);

    if (lBase <= 1e-5) continue;

    base_c *= lBase;

    vector L;
    float max_d = 1e10;
    float fall = 1;

    if (shader_id == \"DomeLight\")
    {
        if (env_path != \"\")
        {
            vector n_dir = N * dome_rot;
            vector irradiance = colormap(
                    env_path,
                    (atan2pi(-n_dir.x, n_dir.z) * 0.5) + 0.5,
                    asinpi(clamp(n_dir.y, -1, 1)) * 0.5 + 0.5,
                    \"filter\", \"gauss\",
                    \"blur\", 1,
                    \"lerp\", 1
            );
    
            vector r_dir = reflect(-V, N) * dome_rot;
            float m_rough = pow(rough, 1.5);
            vector env_sample = pow(colormap(env_path, (atan2pi(-r_dir.x, r_dir.z) * 0.5) + 0.5, asinpi(r_dir.y) * 0.5 + 0.5, \"blur\", m_rough, \"lerp\", 1), GAMMA);
    
            vector F_ibl = F0 + (1 - F0) * pow(1 - dotNV, 5);
            float norm = 0.1 / max(0.001, m_rough + 0.1);
            vector final_spec_ibl = has_sph ? lerp(F_ibl * env_sample, sph_spec, sph_blend) : F_ibl * env_sample;
    
            accumulated_light += ((alb / PI) * (1 - metal) * irradiance * (1 - 0.5 * diffuse_rough) * (diffuse * chf(\"diffuse_amount\")) + final_spec_ibl * (specular_mult * specular) * norm) * base_c * ao;
        }
        else
        {
            vector diff_ibl = (alb / PI) * (1 - metal) * base_c * orenNayar(N, N, V, diffuse_rough) * (diffuse * chf(\"diffuse_amount\"));
            accumulated_light += (has_sph ? (diff_ibl + sph_spec * (specular_mult * specular)) : diff_ibl) * ao;
        }
    
        continue;
    }

    if (shader_id == \"DistantLight\")
    {
        L = -normalize(lDir);
        fall = 1;
    }
    else if (shader_id == \"CylinderLight\")
    {
        float cylHeight = prim(2, \"cylinder_length\", i);
        vector toP = @P - lPos;
        vector closest = lPos + normalize(lDir) * clamp(dot(toP, normalize(lDir)), -cylHeight * 0.5, cylHeight * 0.5);
        vector L_vec = closest - @P;
        max_d = length(L_vec);
        L = L_vec / max(1e-6, max_d);
        fall = 1 / max(0.001, max_d * max_d + pow(radius, 2));
    } 
    else
    {
        vector L_vec = lPos - @P;
        max_d = length(L_vec); L = L_vec / max(1e-6, max_d);
        fall = 1 / max(0.001, max_d * max_d + pow(radius, 2));
        if (shader_id == \"RectLight\" || shader_id == \"DiskLight\")
        {
            fall *= max(0, dot(-L, normalize(lDir)));
        }
    }

    float raw_dotNL = dot(N,L);
    float dotNL = max(0, raw_dotNL);
    float wrap = chf(\"diffuse_wrap\");
    float dotNL_shade = max(0, (dot(n_shade, L) + wrap) / (1 + wrap));
    float diffuse_brdf = orenNayar(N, L, V, diffuse_rough);
    if (dotNL <= 0 && dotNL_shade <= 0) continue;
    
    if (chi(\"enable_shadows\"))
    {
        vector hit_p;
        float shadow_bias = chi(\"use_shadow_bias\") == 0
            ? scene_size * 1e-2
            : chf(\"shadow_bias\");
        if (intersect(1, @P + N * (shadow_bias), L * (shader_id == \"DistantLight\" ? 1e6 : max_d), hit_p, vector(0)) != -1) continue;
    }

    vector H = normalize(L + V);
    float dotNH = max(0, dot(N, H)), dotVH = max(0, dot(V, H));
    float D = a2 / (PI * pow(dotNH * dotNH * (a2 - 1) + 1, 2));
    float G = (max(0, dotNL) / (max(0, dotNL) * (1 - k_pbr) + k_pbr)) * (dotNV / (dotNV * (1 - k_pbr) + k_pbr));
    vector F = F0 + (1 - F0) * pow(1 - dotVH, 5);
    vector brdf_spec = (D * G * F) / max(1e-4, 4 * max(dotNL * dotNV, 1e-4));
    vector spec_contribution = dotNL > 0 ? clamp(brdf_spec * (specular_mult * specular) * max(0, dotNL), 0, 10) : 0;
    
    accumulated_light += (spec_contribution + (alb / PI * (1 - metal) * diffuse_brdf * dotNL_shade * (diffuse * chf(\"diffuse_amount\")))) * base_c * (shader_id == \"DistantLight\" ? 1 : fall);

}

vector final_color = lerp(accumulated_light, captured_color * emission_color, emission);
v@Cd = has_sph ? pow(final_color, INV_G) : final_color;
if (chi(\"prev_albedo\")) v@Cd = alb;
if (chi(\"prev_roughness\")) v@Cd = rough;

if (has_sph)
{
    vector relit_display = clamp(v@Cd, 0, 1);
    vector orig_alb_display = clamp(set(sh_r[0], sh_g[0], sh_b[0]) * SH_C0 + 0.5, 0, 1);
    float orig_lum = max(1e-4, 0.2126 * orig_alb_display.x + 0.7152 * orig_alb_display.y + 0.0722 * orig_alb_display.z);
    float relit_lum = 0.2126 * relit_display.x + 0.7152 * relit_display.y + 0.0722 * relit_display.z;
    float lum_ratio = pow(clamp(relit_lum / orig_lum, 0, 4), 0.5);

    float sh_out_r[], sh_out_g[], sh_out_b[];
    resize(sh_out_r, 16); resize(sh_out_g, 16); resize(sh_out_b, 16);
    sh_out_r[0] = (relit_display.x - 0.5) / SH_C0;
    sh_out_g[0] = (relit_display.y - 0.5) / SH_C0;
    sh_out_b[0] = (relit_display.z - 0.5) / SH_C0;

    float max_coeff = 0;
    for (int m = 1; m < 16; m++) max_coeff = max(max_coeff, max(abs(sh_r[m]), max(abs(sh_g[m]), abs(sh_b[m]))));
    float coeff_limit = max(0.1, max_coeff * 0.75);

    for (int k = 1; k < 16; k++)
    {
        float sr = sh_r[k] * lum_ratio, sg = sh_g[k] * lum_ratio, sb = sh_b[k] * lum_ratio;
        sh_out_r[k] = (abs(sr) > coeff_limit) ? sign(sr) * (coeff_limit + (abs(sr) - coeff_limit) / (1 + (abs(sr) - coeff_limit))) : sr;
        sh_out_g[k] = (abs(sg) > coeff_limit) ? sign(sg) * (coeff_limit + (abs(sg) - coeff_limit) / (1 + (abs(sg) - coeff_limit))) : sg;
        sh_out_b[k] = (abs(sb) > coeff_limit) ? sign(sb) * (coeff_limit + (abs(sb) - coeff_limit) / (1 + (abs(sb) - coeff_limit))) : sb;
    }
    setpointattrib(0, \"GS_SPH_R\", @ptnum, sh_out_r, \"set\");
    setpointattrib(0, \"GS_SPH_G\", @ptnum, sh_out_g, \"set\");
    setpointattrib(0, \"GS_SPH_B\", @ptnum, sh_out_b, \"set\");
}"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
roughness	[ 0	locks=0 ]	(	[ roughness	0 ] 	)
metalness	[ 0	locks=0 ]	(	[ metalness	0 ] 	)
ior	[ 0	locks=0 ]	(	[ ior	0 ] 	)
enable_shadows	[ 0	locks=0 ]	(	[ enable_shadows	0 ] 	)
shadow_bias	[ 0	locks=0 ]	(	[ shadow_bias	0 ] 	)
normal_softness	[ 0	locks=0 ]	(	[ normal_softness	0 ] 	)
diffuse_wrap	[ 0	locks=0 ]	(	[ diffuse_wrap	0 ] 	)
diffuse_amount	[ 0	locks=0 ]	(	[ diffuse_amount	0 ] 	)
specular	[ 0	locks=0 ]	(	[ specular	0 ] 	)
sph_rough_bias	[ 0	locks=0 ]	(	[ sph_rough_bias	0 ] 	)
sph_blend	[ 0	locks=0 ]	(	[ sph_blend	0 ] 	)
prev_albedo	[ 0	locks=0 ]	(	[ prev_albedo	0 ] 	)
prev_roughness	[ 0	locks=0 ]	(	[ prev_roughness	0 ] 	)
base_color	[ 0	locks=0 ]	(	[ base_colorx	0 ] 	[ base_colory	0 ] 	[ base_colorz	0 ] 	)
sph_rough_gain	[ 0	locks=0 ]	(	[ sph_rough_gain	0 ] 	)
use_shadow_bias	[ 0	locks=0 ]	(	[ use_shadow_bias	0 ] 	)
diffuse_roughness	[ 0	locks=0 ]	(	[ diffuse_roughness	0 ] 	)
emission	[ 0	locks=0 ]	(	[ emission	0 ] 	)
emission_color	[ 0	locks=0 ]	(	[ emission_colorx	0 ] 	[ emission_colory	0 ] 	[ emission_colorz	0 ] 	)
}

