--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/group_by_insidedness.chn"
Content-Type: text/plain

{
    channel min_inner {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../mininnerangle\") }
    }
    channel max_inner {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../maxinnerangle\") }
    }
    channel min_outer {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../minouterangle\") }
    }
    channel max_outer {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../maxouterangle\") }
    }
    channel enable_inside_group {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enableinsidegroup\") }
    }
    channel enable_outside_group {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enableoutsidegroup\") }
    }
    channel enable_angle_attribute {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enableangleattrib\") }
    }
    channel enable_inside_attrib {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enableinsideattrib\") }
    }
    channel enable_outside_attrib {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enableoutsideattrib\") }
    }
    channel enable_directional_N {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../enabledirectionalnormal\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/group_by_insidedness.parm"
Content-Type: text/plain

{
version 0.8
folder0	[ 0	locks=0 ]	(	0	0	)
group	[ 0	locks=0 ]	(	`chs(\"../group\")`	)
grouptype	[ 0	locks=0 ]	(	"guess"	)
class	[ 0	locks=0 ]	(	"point"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"float mininner = chf('min_inner');
float maxinner = chf('max_inner');
float minouter = chf('min_outer');
float maxouter = chf('max_outer');

int enableinsidegroup = chi('enable_inside_group');
string insidegroup = chs('inside_group');
int enableinsideattrib = chi('enable_inside_attrib');
string insideattrib = chs('inside_attrib');

int enableoutsidegroup = chi('enable_outside_group');
string outsidegroup = chs('outside_group');
int enableoutsideattrib = chi('enable_outside_attrib');
string outsideattrib = chs('outside_attrib');

int enableangleattrib = chi('enable_angle_attribute');
string angleattribute = chs('angle_attribute');

int enabledirectionalN = chi('enable_directional_N');
string directionalN = chs('directional_angle');

float pi = 3.14159265359;

// setup the previous and next point numbers, wrapping around for first and last points 
int next_pt = (@ptnum+1)%npoints(0);

int prev_pt = @ptnum -1;
if (prev_pt == -1)
{
    prev_pt = npoints(0)-1;
}

// grab the previous and next positions 
vector prev_p = point(0, \"P\", prev_pt);
vector next_p = point(0, \"P\", next_pt);

// get the directions from the current point to the previous and next points 
vector d1 = normalize(v@P - prev_p);
vector d2 = normalize(next_p - v@P);

// Optionally export Normal
if (enabledirectionalN == 1)
{
    vector Pt1 = @P + normalize(next_p - @P);
    vector Pt2 = @P + normalize(prev_p - @P);
    vector Avg = (Pt1 + Pt2) / 2;
    setpointattrib(0, directionalN, @ptnum, normalize(Avg - @P), \"set\");
}

// the up direction of the cross product of those 2 directions determines the insidedness of a point 
float check = prim_normal(0,0,@P).y; 

float up = (normalize(cross(d1, d2)).y)*check;

float largestcomponentvalue = 0;

// we also calculate the dot product of those 2 vector for some extra filtering
float dot_product = dot(d2, d1);

float angle = acos(dot_product) * 180/pi;

//set groups and attributes
if (enableoutsideattrib == 1)
{
    setpointattrib(0, outsideattrib, @ptnum, 0,'set');
}
if (enableinsideattrib == 1)
{
    setpointattrib(0, insideattrib, @ptnum, 0,'set');
}
    
if (up > 0)
{   
    if (angle > mininner && angle < maxinner)
    {   
        if (enableinsidegroup == 1)
        {
            setpointgroup(0, insidegroup, @ptnum, 1);
        }
        if (enableinsideattrib == 1)
        {
            setpointattrib(0, insideattrib, @ptnum, 1,'set');
        }
    }
}
else if (up < 0)
{
    if (angle > minouter && angle < maxouter)
    {
        if (enableoutsidegroup == 1)            
        {
            setpointgroup(0, outsidegroup, @ptnum, 1);
        }
        if (enableoutsideattrib == 1)
        {
            setpointattrib(0, outsideattrib, @ptnum, 1,'set');
        }
    }    
}
    
//Optionally export angle 
if (enableangleattrib == 1)
{
    setpointattrib(0,angleattribute,@ptnum,rint(angle*10)/10,'set');
} "	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
min_inner	[ 8	locks=0 ]	(	[ min_inner	0 ] 	)
max_inner	[ 8	locks=0 ]	(	[ max_inner	0 ] 	)
min_outer	[ 8	locks=0 ]	(	[ min_outer	0 ] 	)
max_outer	[ 8	locks=0 ]	(	[ max_outer	0 ] 	)
inside_group	[ 0	locks=0 ]	(	`chs(\"../insidegroup\")`	)
outside_group	[ 0	locks=0 ]	(	`chs(\"../outsidegroup\")`	)
angle_attribute	[ 0	locks=0 ]	(	`chs(\"../angleattrib\")`	)
enable_inside_group	[ 8	locks=0 ]	(	[ enable_inside_group	0 ] 	)
enable_outside_group	[ 8	locks=0 ]	(	[ enable_outside_group	0 ] 	)
enable_angle_attribute	[ 8	locks=0 ]	(	[ enable_angle_attribute	0 ] 	)
enable_inside_attrib	[ 8	locks=0 ]	(	[ enable_inside_attrib	0 ] 	)
inside_attrib	[ 0	locks=0 ]	(	`chs(\"../insideattrib\")`	)
enable_outside_attrib	[ 8	locks=0 ]	(	[ enable_outside_attrib	0 ] 	)
outside_attrib	[ 0	locks=0 ]	(	`chs(\"../outsideattrib\")`	)
enable_directional_N	[ 8	locks=0 ]	(	[ enable_directional_N	0 ] 	)
directional_angle	[ 0	locks=0 ]	(	`chs(\"../adddirectionalnormal\")`	)
}

