    group {
        name    "folder1"
        label   "Code"

        parm {
            name    "group"
            baseparm
            label   "Group"
            export  none
            bindselector uvselect "Modify Attribs"
                "Select the geometry to affect and press Enter to complete."
                0 1 0xffffffff 0 grouptype 0
        }
        parm {
            name    "grouptype"
            baseparm
            label   "Group Type"
            export  none
        }
        parm {
            name    "class"
            baseparm
            label   "Run Over"
            export  none
        }
        parm {
            name    "vex_numcount"
            baseparm
            label   "Number Count"
            export  none
        }
        parm {
            name    "vex_threadjobsize"
            baseparm
            label   "Thread Job Size"
            export  none
        }
        groupsimple {
            name    "folder_generatedparms_snippet"
            label   "Generated Channel Parameters"
            grouptag { "group_type" "simple" }
            grouptag { "sidefx::look" "blank" }

            parm {
                name    "min_inner"
                label   "Min Inner"
                type    float
                default { "0" }
                range   { 0 1 }
            }
            parm {
                name    "max_inner"
                label   "Max Inner"
                type    float
                default { "0" }
                range   { 0 1 }
            }
            parm {
                name    "min_outer"
                label   "Min Outer"
                type    float
                default { "0" }
                range   { 0 1 }
            }
            parm {
                name    "max_outer"
                label   "Max Outer"
                type    float
                default { "0" }
                range   { 0 1 }
            }
            parm {
                name    "inside_group"
                label   "Inside Group"
                type    string
                default { "" }
            }
            parm {
                name    "outside_group"
                label   "Outside Group"
                type    string
                default { "" }
            }
            parm {
                name    "angle_attribute"
                label   "Angle Attribute"
                type    string
                default { "" }
            }
            parm {
                name    "enable_inside_group"
                label   "Enable Inside Group"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "enable_outside_group"
                label   "Enable Outside Group"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "enable_angle_attribute"
                label   "Enable Angle Attribute"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "enable_inside_attrib"
                label   "Enable Inside Attrib"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "inside_attrib"
                label   "Inside Attrib"
                type    string
                default { "" }
            }
            parm {
                name    "enable_outside_attrib"
                label   "Enable Outside Attrib"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "outside_attrib"
                label   "Outside Attrib"
                type    string
                default { "" }
            }
            parm {
                name    "enable_directional_N"
                label   "Enable Directional N"
                type    integer
                default { "0" }
                range   { 0 10 }
            }
            parm {
                name    "directional_angle"
                label   "Directional Angle"
                type    string
                default { "" }
            }
        }

        parm {
            name    "snippet"
            baseparm
            label   "VEXpression"
            export  all
        }
        parm {
            name    "exportlist"
            baseparm
            label   "Attributes to Create"
            export  none
        }
        parm {
            name    "vex_strict"
            baseparm
            label   "Enforce Prototypes"
            export  none
        }
        parm {
            name    "vex_strictvariables"
            baseparm
            label   "Standard Variable Names Only"
            export  none
        }
    }

    group {
        name    "folder1_1"
        label   "Bindings"

        parm {
            name    "autobind"
            baseparm
            label   "Autobind by Name"
            export  none
        }
        multiparm {
            name    "bindings"
            label    "Number of Bindings"
            baseparm
            default 0
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "multistartoffset" "1" }

            parm {
