{
    channel bindings1_intval {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"./flip\") }
    }
    channel bindings2_intval {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"./swizzle\") }
    }
    channel flip {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../xyz_flip\") }
    }
    channel swizzle {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../xyz_swizzle\") }
    }
  }

--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/rgb.parm"
Content-Type: text/plain

{
version 0.8
stdswitcher	[ 0	locks=0 ]	(	0	0	0	0	0	)
kernelcode	[ 0	locks=0 ]	(	"#bind layer src? float3 val=0
#bind layer !&dst float3
#bind parm flip int val=0
#bind parm swizzle int val=0

constant float3 flip_lut[8] = {
    (float3)( 1.0f,  1.0f,  1.0f), // 0
    (float3)(-1.0f,  1.0f,  1.0f), // 1
    (float3)( 1.0f, -1.0f,  1.0f), // 2
    (float3)( 1.0f,  1.0f, -1.0f), // 3
    (float3)(-1.0f, -1.0f,  1.0f), // 4
    (float3)(-1.0f,  1.0f, -1.0f), // 5
    (float3)(-1.0f, -1.0f, -1.0f), // 6
    (float3)( 1.0f, -1.0f, -1.0f)  // 7
};

@KERNEL
{
    float3 v = @src.xyz;
    v *= flip_lut[clamp(@flip, 0, 7)];
    switch (clamp(@swizzle, 0, 5))
    {
        case 0: v = v.xyz; break; // 0
        case 1: v = v.xzy; break; // 1
        case 2: v = v.yxz; break; // 2
        case 3: v = v.yzx; break; // 3
        case 4: v = v.zxy; break; // 4
        case 5: v = v.zyx; break; // 5
    }
    @dst.set(v);
}"	)
options_runover	[ 0	locks=0 ]	(	"layer"	)
kernelname	[ 0	locks=0 ]	(	generickernel	)
writebackkernelname	[ 0	locks=0 ]	(	writebackkernel	)
kerneloptions	[ 0	locks=0 ]	(	""	)
options_tile	[ 0	locks=0 ]	(	1	1	)
options_usevdbtile	[ 0	locks=0 ]	(	"off"	)
options_vdbtile	[ 0	locks=0 ]	(	1	1	1	)
options_iterations	[ 0	locks=0 ]	(	1	)
options_iteration	[ 0	locks=0 ]	(	"off"	)
usewritebackkernel	[ 0	locks=0 ]	(	"off"	)
options_time	[ 0	locks=0 ]	(	"off"	)
options_timeinccontext	[ 0	locks=0 ]	(	"on"	)
options_timeinc	[ 0	locks=0 ]	(	"off"	)
