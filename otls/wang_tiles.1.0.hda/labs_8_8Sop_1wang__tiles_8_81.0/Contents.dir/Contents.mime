class	[ 0	locks=0 ]	(	"detail"	)
vex_numcount	[ 0	locks=0 ]	(	10	)
vex_threadjobsize	[ 0	locks=0 ]	(	1024	)
snippet	[ 0	locks=0 ]	(	"vector pos_pt0 = point(0, \"P\", 0);
vector pos_pt1 = point(0, \"P\", 1);

float size_x = getbbox_size(0).x;
float size_z = getbbox_size(0).z;
float unit = distance(pos_pt0, pos_pt1);

int cols = int(rint(size_x / unit)) + 1;
int rows = int(rint(size_z / unit)) + 1;

f@_wat_unit = unit;
i@_wat_cols = cols;
i@_wat_rows = rows;"	)
