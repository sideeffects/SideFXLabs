--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/CONTROLLER.spareparmdef"
Content-Type: text/plain

    parm {
        name    "copyinput"
        baseparm
        label   "Copy Input (Note: Input will be still cooked if disabled)"
        invisible
        export  none
    }
    parm {
        name    "cacheinput"
        baseparm
        label   "Cache Input"
        invisible
        export  none
    }
    groupsimple {
        name    "fd_index"
        label   "Index"

        groupsimple {
            name    "fd_text"
            label   "Text"

            parm {
                name    "file"
                label   "Font"
                type    file
                default { "Lato" }
                menureplace {
                    [ "opmenu -l -a fonts/font_hollow file" ]
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.ttf, *.otf, *.ttc, *.otc, *.pfa, *.pfb" }
            }
            parm {
                name    "blobfontsize"
                label   "Blob Font Size"
                type    float
                default { "0.1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "edgefontsize"
                label   "Edge Font Size"
                type    float
                default { "0.1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "cornerfontsize"
                label   "Corner Font Size"
                type    float
                default { "0.1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "fd_indexshape"
            label   "Shape"

            parm {
                name    "circle_radius"
                label   "Blob Size"
                type    float
                default { "1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "edgesize"
                label   "Edge Size"
                type    float
                default { "1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "cornersize"
                label   "Corner Size"
                type    float
                default { "1" }
                range   { 0! 1 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sepparm2"
                label   "Spacer"
                type    separator
                default { "" }
                parmtag { "sidefx::layout_height" "small" }
                parmtag { "sidefx::look" "blank" }
            }
            parm {
                name    "indexdrawoutline"
                label   "Draw Outline"
                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "indexoutlinewidth"
                label   "Outline Width"
                type    float
                default { "0.025" }
                disablewhen "{ indexdrawoutline != 1 }"
                range   { 0! 0.01 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "indexoutlinemode"
                label   "Alignment"
                type    ordinal
                default { "center" }
                disablewhen "{ indexdrawoutline != 1 }"
                menu {
                    "inside"    "Inside"
                    "outside"   "Outside"
                    "center"    "Center"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "indexdoaa"
                label   "Anti-Aliasing"
                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "fd_indexcolors"
            label   "Colors"

            parm {
                name    "indextext"
                label   "Text"
                type    color
                size    3
                default { "1" "1" "1" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "indexfill"
                label   "Fill"
                type    color
                size    3
                default { "0.1" "0.1" "0.1" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "indexoutline"
                label   "Outline"
                type    color
                size    3
                default { "0" "0" "0" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    groupsimple {
        name    "fd_shape"
        label   "Shape"

        groupsimple {
            name    "fd_colors"
            label   "Colors"

            parm {
                name    "colora"
                label   "Color A"
                type    color
                size    3
                default { "1" "1" "0" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "colorb"
                label   "Color B"
                type    color
                size    3
                default { "0" "0.5" "1" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sepparm"
                label   "Spacer"
                type    separator
                default { "" }
                parmtag { "sidefx::layout_height" "small" }
                parmtag { "sidefx::look" "blank" }
            }
            parm {
                name    "shapeoutline"
                label   "Outline"
                type    color
                size    3
                default { "0" "0" "0" }
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "fd_shapeoutline"
            label   "Outline"

            parm {
                name    "shapedrawoutline"
                label   "Draw Outline"
                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shapeoutlinewidth"
                label   "Outline Width"
                type    float
                default { "0.025" }
                disablewhen "{ shapedrawoutline != 1 }"
                range   { 0! 0.01 }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shapeoutlinemode"
                label   "Alignment"
                type    ordinal
                default { "center" }
                disablewhen "{ shapedrawoutline != 1 }"
                menu {
                    "inside"    "Inside"
                    "outside"   "Outside"
                    "center"    "Center"
                }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shapedoaa"
                label   "Anti-Aliasing"
                type    toggle
                default { "on" }
                parmtag { "autoscope" "0000000000000000" }
                parmtag { "script_callback_language" "python" }
            }
        }

    }


--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/CONTROLLER.chn"
Content-Type: text/plain

{
    channel colorar {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../colorar\") }
    }
    channel colorag {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../colorag\") }
    }
    channel colorab {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../colorab\") }
    }
    channel colorbr {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { length = 0 expr = ch(\"../colorbr\") }
    }
    channel colorbg {
      lefttype = extend
      righttype = extend
      default = 0.5
      flags = 0
      segment { length = 0 value = 0.5 0.5 expr = ch(\"../colorbg\") }
    }
    channel colorbb {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { length = 0 value = 1 1 expr = ch(\"../colorbb\") }
    }
  }

