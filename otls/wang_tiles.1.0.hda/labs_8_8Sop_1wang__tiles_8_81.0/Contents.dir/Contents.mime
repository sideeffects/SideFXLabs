            label   "Shape Edge Filter"
            export  none
        }
        parm {
            name    "cutout_falloff"
            baseparm
            label   "Shape Falloff"
            export  none
        }
    }

    groupsimple {
        name    "folder6"
        label   "Options"
        grouptag { "sidefx::switcher" "folder3" }

        parm {
            name    "space"
            baseparm
            label   "Stamp Mode"
            export  none
        }
        parm {
            name    "attribmode"
            baseparm
            label   "Instancing Attributes"
            export  none
        }
        parm {
            name    "upaxis"
            baseparm
            label   "Up Axis"
            export  none
        }
        parm {
            name    "rotationmethod"
            baseparm
            label   "Rotation from"
            export  none
        }
        parm {
            name    "zfalloff"
            baseparm
            label   "Z Falloff"
            export  none
        }
        parm {
            name    "numstamps"
            baseparm
            label   "Number of Stamps"
            export  none
        }
        parm {
