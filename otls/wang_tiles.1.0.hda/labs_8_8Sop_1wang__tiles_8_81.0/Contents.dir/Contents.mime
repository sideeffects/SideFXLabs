int southnum = (@ptnum > (gridX * gridZ) - gridX - 1) ? -1 : @ptnum + gridX;

// Get axis aligned neighbor values
int east = (eastnum == -1) ? 0 : 1 - int(rint(vector(point(0, attribute, eastnum))[channel]));
int west = (westnum == -1) ? 0 : 1 - int(rint(vector(point(0, attribute, westnum))[channel]));
int south = (southnum == -1) ? 0 : 1 - int(rint(vector(point(0, attribute, southnum))[channel]));
int north = (northnum == -1) ? 0 : 1 - int(rint(vector(point(0, attribute, northnum))[channel]));

// Flood fill diagonal neighbors if direct neighbors are not 1
if (north == 1)
    north = 1;
if (east == 1)
    east = 2;
if (west == 1)
    west = 8;
if (south == 1)
    south = 4;

// Get index
int index = north + east + south + west;

// if (rint(v@Cd[channel]) == 1)
//     index =0;

if (rint(vector(point(0, attribute, @ptnum))[channel]) == 1)
    index = 0;

// Convert to name attribute for copytopoints sop
i@stamp = index;
s@_wat_name = itoa(index);"	)
exportlist	[ 0	locks=0 ]	(	*	)
vex_strict	[ 0	locks=0 ]	(	"off"	)
vex_strictvariables	[ 0	locks=0 ]	(	"on"	)
autobind	[ 0	locks=0 ]	(	"on"	)
bindings	[ 0	locks=0 ]	(	0	)
groupautobind	[ 0	locks=0 ]	(	"on"	)
groupbindings	[ 0	locks=0 ]	(	0	)
vex_cwdpath	[ 0	locks=0 ]	(	.	)
vex_outputmask	[ 0	locks=0 ]	(	*	)
vex_updatenmls	[ 0	locks=0 ]	(	"off"	)
vex_matchattrib	[ 0	locks=0 ]	(	id	)
vex_inplace	[ 0	locks=0 ]	(	"off"	)
vex_selectiongroup	[ 0	locks=0 ]	(	""	)
vex_precision	[ 0	locks=0 ]	(	auto	)
folder1	[ 0	locks=0 ]	(	0	0	)
folder_generatedparms_snippet	[ 0	locks=0 ]	(	0	)
attribute	[ 0	locks=0 ]	(	`chs(\"../attributename\")`	)
channel	[ 0	locks=0 ]	(	[ channel	0 ] 	)
}

